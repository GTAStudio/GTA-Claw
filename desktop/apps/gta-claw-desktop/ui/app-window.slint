import { FirstRunSurface } from "@gta-ui/first-run.slint";
import { GatewayOnboardingSurface } from "@gta-ui/gateway-onboarding.slint";
import { FocusHistory } from "@gta-ui/primitives.slint";
import {
    ActivityItem,
    CommandItem,
    DeliverableItem,
    DiffItem,
    ExtensionItem,
    FileItem,
    ProductShell,
    RunItem,
    ScheduleItem,
    TranscriptItem,
    WorkspaceItem,
} from "@gta-ui/product-shell.slint";
import { DesignTokens, StatusKind, ThemeMode, VisualPreferences } from "@gta-ui/tokens.slint";
export { DesignTokens, VisualPreferences }
export {
    ActivityItem,
    CommandItem,
    DeliverableItem,
    DiffItem,
    ExtensionItem,
    FileItem,
    RunItem,
    ScheduleItem,
    TranscriptItem,
    WorkspaceItem,
}

export component AppWindow inherits Window {
    title: "GTA Claw Gateway";
    preferred-width: 1080px;
    preferred-height: 720px;
    min-width: 720px;
    min-height: 520px;

    in property <string> state-title: "Connect to your Gateway";
    in property <string> state-detail: "Run a real bounded Gateway diagnostic.";
    in property <string> status-text: "Not connected";
    in property <string> status-label: "Status";
    in property <string> status-icon: "-";
    in property <StatusKind> status-kind: StatusKind.neutral;
    in property <string> endpoint-summary: "Not selected";
    in property <string> server-summary: "Not connected";
    in property <string> protocol-summary: "Not negotiated";
    in property <string> role-summary: "Not authenticated";
    in property <string> scopes-summary: "No effective scopes";
    in property <string> health-summary: "Not checked";
    in property <string> identity-summary: "Created only after consent";
    in property <string> error-message: "";
    in property <string> error-action: "";
    in property <bool> busy: false;
    in property <bool> can-connect: true;
    in property <bool> can-cancel: false;
    in property <bool> can-disconnect: false;
    in property <bool> can-retry: false;
    in-out property <string> endpoint-input: "ws://localhost:18789";
    in-out property <bool> endpoint-reset-selector: false;
    in-out property <bool> endpoint-preserve-focus: false;
    in-out property <string> token-input: "";
    in-out property <bool> token-reset-selector: false;
    in-out property <bool> token-preserve-focus: false;
    in-out property <bool> consent-checked: false;
    in property <length> layout-width: root.width;
    out property <bool> narrow-layout: root.layout-width < 900px;
    out property <bool> navigation-global-focus-active: application-focus.has-focus;
    out property <string> connection-focused-action: "";
    out property <bool> gateway-summary-text-bounds-fit: true;
    out property <bool> gateway-summary-high-density-stacked: false;
    in-out property <bool> product-preview-open: false;
    in property <int> onboarding-stage: 0;
    in property <int> selected-screen: 0;
    in property <int> selected-settings-section: 0;
    in property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in property <[CommandItem]> palette-commands;
    in property <int> palette-selected-index: 0;
    in property <int> palette-command-count: 0;
    in property <int> palette-selected-action-id: -1;
    in property <string> palette-selected-label: "";
    in-out property <int> palette-focused-command-index: -1;
    out property <bool> palette-trigger-focused: false;
    out property <bool> preview-dismiss-trigger-focused: false;
    out property <bool> appearance-contrast-focused: false;
    out property <bool> approval-text-bounds-fit: true;
    out property <bool> approval-controls-bounds-fit: true;
    out property <bool> approval-controls-no-overlap: true;
    out property <bool> approval-actions-stacked: false;
    out property <bool> question-text-bounds-fit: true;
    out property <bool> question-controls-bounds-fit: true;
    out property <bool> question-controls-no-overlap: true;
    out property <bool> question-actions-stacked: false;
    out property <bool> workspace-card-text-bounds-fit: true;
    out property <bool> workspace-card-icon-bounds-fit: true;
    out property <bool> workspace-card-badge-bounds-fit: true;
    out property <bool> workspace-card-button-bounds-fit: true;
    out property <bool> workspace-card-no-overlap: true;
    out property <bool> workspace-card-stacked: false;
    out property <bool> schedule-card-text-bounds-fit: true;
    out property <bool> schedule-card-icon-bounds-fit: true;
    out property <bool> schedule-card-badge-bounds-fit: true;
    out property <bool> schedule-card-button-bounds-fit: true;
    out property <bool> schedule-card-no-overlap: true;
    out property <bool> schedule-card-stacked: false;
    out property <bool> extension-card-text-bounds-fit: true;
    out property <bool> extension-card-icon-bounds-fit: true;
    out property <bool> extension-card-badge-bounds-fit: true;
    out property <bool> extension-card-button-bounds-fit: true;
    out property <bool> extension-card-no-overlap: true;
    out property <bool> extension-card-stacked: false;
    out property <bool> first-run-heading-text-bounds-fit: true;
    out property <bool> first-run-heading-high-density-wrapped: false;
    out property <bool> first-run-content-bounds-fit: true;
    out property <bool> session-header-text-bounds-fit: true;
    out property <bool> session-header-back-bounds-fit: true;
    out property <bool> session-header-status-bounds-fit: true;
    out property <bool> session-header-no-overlap: true;
    out property <bool> session-header-stacked: false;
    out property <bool> application-header-title-bounds-fit: true;
    out property <bool> application-header-badge-bounds-fit: true;
    out property <bool> settings-rail-bounds-fit: true;
    out property <bool> product-viewport-bounds-fit: true;
    out property <bool> session-narrow-layout:
        root.layout-width < 1040px || root.density-scale > 1.25;
    out property <bool> focused-run-visible: true;
    out property <int> focused-run-visibility-generation: 0;
    out property <length> background-scroll-position: 0px;
    out property <[CommandItem]> command-catalog: [
        {
            action-id: 0,
            glyph: "F",
            title: @tr("Go to Preview Focus"),
            detail: @tr("Ctrl/Cmd+1"),
            keywords: @tr("focus home attention overview"),
        },
        {
            action-id: 1,
            glyph: "W",
            title: @tr("View Workspace Previews"),
            detail: @tr("Ctrl/Cmd+2"),
            keywords: @tr("workspace repository local remote git"),
        },
        {
            action-id: 2,
            glyph: "R",
            title: @tr("Open Run Preview"),
            detail: @tr("Ctrl/Cmd+3"),
            keywords: @tr("runs sessions tasks monitor"),
        },
        {
            action-id: 3,
            glyph: "S",
            title: @tr("Open Schedule Preview"),
            detail: @tr("Ctrl/Cmd+4"),
            keywords: @tr("schedules recurring cadence automation"),
        },
        {
            action-id: 4,
            glyph: "D",
            title: @tr("Open Deliverable Preview"),
            detail: @tr("Ctrl/Cmd+5"),
            keywords: @tr("deliverables files artifacts output"),
        },
        {
            action-id: 5,
            glyph: "E",
            title: @tr("Open Extension Preview"),
            detail: @tr("Ctrl/Cmd+6"),
            keywords: @tr("extensions roles tools permissions"),
        },
        {
            action-id: 6,
            glyph: "G",
            title: @tr("Open Settings"),
            detail: @tr("Ctrl/Cmd+7"),
            keywords: @tr("settings preferences appearance connection"),
        },
        {
            action-id: 7,
            glyph: "?",
            title: @tr("Show keyboard shortcuts"),
            detail: @tr("Settings"),
            keywords: @tr("help keyboard shortcuts keys"),
        },
        {
            action-id: 8,
            glyph: "U",
            title: @tr("View update availability"),
            detail: @tr("Settings"),
            keywords: @tr("update upgrade release version unavailable guidance"),
        },
        {
            action-id: 9,
            glyph: "H",
            title: @tr("View diagnostic availability"),
            detail: @tr("Settings"),
            keywords: @tr("diagnostics health renderer gateway accessibility availability"),
        },
    ];
    in property <int> diff-mode: 0;
    in property <[RunItem]> runs;
    in property <[WorkspaceItem]> workspaces;
    in property <[ScheduleItem]> schedules;
    in property <[DeliverableItem]> deliverables;
    in property <[ExtensionItem]> extensions;
    in property <[TranscriptItem]> transcript;
    in property <[ActivityItem]> activity;
    in property <[DiffItem]> diff-lines;
    in property <[FileItem]> session-files;
    in property <int> selected-file-index: 0;
    in property <string> selected-file-name: "";
    in property <string> session-title: "Session";
    in property <string> session-state: "Draft";
    in property <string> session-detail: "";
    in property <int> session-tone: 0;
    in property <bool> can-approve: false;
    in property <bool> can-answer: false;
    in property <bool> product-interactions-enabled: false;
    in property <string> approval-prompt: "";
    in property <string> approval-scope: "";
    in property <string> question: "";
    in property <int> selected-deliverable-index: 0;
    in property <string> selected-deliverable-name: "";
    in property <string> selected-deliverable-kind: "";
    in property <string> selected-deliverable-source: "";
    in property <string> selected-deliverable-size: "";
    in property <string> selected-deliverable-content: "";
    in property <bool> selected-deliverable-pinned: false;
    in property <string> run-page-label: "Page 1 of 1";
    in property <bool> can-previous-run-page: false;
    in property <bool> can-next-run-page: false;
    in property <int> dashboard-awaiting-review: 0;
    in property <int> dashboard-running: 0;
    in property <int> dashboard-blocked: 0;
    in property <int> dashboard-workspaces: 0;
    in-out property <int> focused-run-index: -1;
    in-out property <ThemeMode> theme-mode <=> VisualPreferences.theme-mode;
    in-out property <bool> high-contrast <=> VisualPreferences.high-contrast;
    in-out property <bool> reduced-motion <=> VisualPreferences.reduced-motion;
    in-out property <float> density-scale <=> VisualPreferences.density-scale;

    callback connect-requested(string, string, bool);
    callback retry-requested(string, string, bool);
    callback preview-requested();
    callback preview-dismiss-requested();
    callback cancel-requested();
    callback disconnect-requested();
    callback error-dismiss-requested();
    callback onboarding-stage-requested(int);
    callback navigate-requested(int);
    callback palette-toggle-requested();
    callback palette-dismiss-requested();
    callback palette-query-changed(string);
    callback palette-selection-step-requested(int);
    callback palette-selection-index-requested(int);
    callback palette-command-requested(int);
    callback open-session-requested(int);
    callback open-workspace-requested(int);
    callback settings-section-requested(int);
    callback update-requested();
    callback diagnostics-requested();
    callback back-requested();
    callback diff-mode-requested(int);
    callback previous-run-page-requested();
    callback next-run-page-requested();
    callback approval-requested(bool);
    callback answer-requested(string);
    callback message-submitted(string);
    callback file-selected(int);
    callback schedule-create-requested();
    callback schedule-toggled(int);
    callback extension-toggled(int);
    callback deliverable-selected(int);
    callback deliverable-pin-toggle-requested();
    callback workspace-card-geometry-observed(int, bool, bool, bool, bool, bool, bool);
    callback schedule-card-geometry-observed(int, bool, bool, bool, bool, bool, bool);
    callback extension-card-geometry-observed(int, bool, bool, bool, bool, bool, bool);

    public function request-close() -> bool {
        return root.close();
    }

    // Mirrored from the onboarding surface because it is conditional: an element
    // inside an `if` cannot be reached by id from here.
    private property <bool> onboarding-endpoint-has-focus: false;
    private property <bool> onboarding-token-has-focus: false;

    public function purge-token-input() {
        root.token-preserve-focus = root.onboarding-token-has-focus;
        root.token-input = "";
        root.token-reset-selector = !root.token-reset-selector;
    }

    public function replace-endpoint-input(value: string) {
        root.endpoint-preserve-focus = root.onboarding-endpoint-has-focus;
        root.endpoint-input = value;
        root.endpoint-reset-selector = !root.endpoint-reset-selector;
    }

    application-focus := FocusScope {
        width: 100%;
        height: 100%;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        private property <bool> observed-product-preview-open: root.product-preview-open;
        private property <int> observed-onboarding-stage: root.onboarding-stage;
        private property <int> observed-selected-screen: root.selected-screen;
        private property <int> observed-focus-restore-generation:
            FocusHistory.restore-generation;

        init => { self.focus(); }
        changed observed-product-preview-open => {
            root.connection-focused-action = "";
            self.focus();
        }
        changed observed-onboarding-stage => {
            root.connection-focused-action = "";
            self.focus();
        }
        changed observed-selected-screen => { self.focus(); }
        changed observed-focus-restore-generation => {
            if (FocusHistory.return-control == "application.global") {
                self.focus();
            }
        }
        key-pressed(event) => {
            if (root.palette-open) {
                if (event.text == Key.F1
                    || ((event.modifiers.control || event.modifiers.meta)
                        && (event.text == "k" || event.text == "K"))) {
                    root.palette-toggle-requested();
                    return accept;
                }
                if (event.text == Key.Escape) {
                    root.palette-dismiss-requested();
                    return accept;
                }
                if (event.text == Key.Tab || event.text == Key.Backtab) {
                    return reject;
                }
                // Focused palette controls handle text, arrows, and Enter. Tab
                // is rejected above for Slint's default focus traversal; all
                // other unhandled keys are consumed before background shortcuts.
                return accept;
            }
            if (root.product-preview-open
                && (event.text == Key.F1
                    || ((event.modifiers.control || event.modifiers.meta)
                        && (event.text == "k" || event.text == "K")))) {
                if (self.has-focus) {
                    FocusHistory.capture-control("application.global");
                } else {
                    FocusHistory.capture-current();
                }
                root.palette-toggle-requested();
                return accept;
            }
            if (root.product-preview-open
                && (event.modifiers.control || event.modifiers.meta)
                && event.text == "1") {
                root.navigate-requested(0);
                self.focus();
                return accept;
            }
            if (root.product-preview-open
                && (event.modifiers.control || event.modifiers.meta)
                && event.text == "2") {
                root.navigate-requested(1);
                self.focus();
                return accept;
            }
            if (root.product-preview-open
                && (event.modifiers.control || event.modifiers.meta)
                && event.text == "3") {
                root.navigate-requested(2);
                self.focus();
                return accept;
            }
            if (root.product-preview-open
                && (event.modifiers.control || event.modifiers.meta)
                && event.text == "4") {
                root.navigate-requested(3);
                self.focus();
                return accept;
            }
            if (root.product-preview-open
                && (event.modifiers.control || event.modifiers.meta)
                && event.text == "5") {
                root.navigate-requested(4);
                self.focus();
                return accept;
            }
            if (root.product-preview-open
                && (event.modifiers.control || event.modifiers.meta)
                && event.text == "6") {
                root.navigate-requested(5);
                self.focus();
                return accept;
            }
            if (root.product-preview-open
                && (event.modifiers.control || event.modifiers.meta)
                && event.text == "7") {
                root.navigate-requested(6);
                self.focus();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (!root.product-preview-open && root.onboarding-stage > 0
                    && root.onboarding-stage < 3) {
                    root.onboarding-stage-requested(root.onboarding-stage - 1);
                    return accept;
                }
                if (!root.product-preview-open && root.onboarding-stage == 3 && root.can-cancel) {
                    root.cancel-requested();
                    return accept;
                }
                if (!root.product-preview-open && root.onboarding-stage == 3 && root.can-disconnect) {
                    root.disconnect-requested();
                    return accept;
                }
            }
            return reject;
        }

    // `if` instead of `visible`: a hidden element still exists, is laid out and
    // keeps its whole subtree alive, so all three surfaces used to be built at
    // startup. `if` builds exactly the surface that is on screen.
    if (!root.product-preview-open && root.onboarding-stage < 3) : FirstRunSurface {
        width: 100%;
        height: 100%;
        stage: root.onboarding-stage;
        available-width: root.layout-width;
        stage-requested(stage) => { root.onboarding-stage-requested(stage); }
        heading-geometry-changed(text-bounds-fit, high-density-wrapped) => {
            root.first-run-heading-text-bounds-fit = text-bounds-fit;
            root.first-run-heading-high-density-wrapped = high-density-wrapped;
        }
        content-geometry-changed(bounds-fit) => {
            root.first-run-content-bounds-fit = bounds-fit;
        }
    }

    if (!root.product-preview-open && root.onboarding-stage == 3) : GatewayOnboardingSurface {
        width: 100%;
        height: 100%;
        available-width: root.layout-width;
        state-title: root.state-title;
        state-detail: root.state-detail;
        status-text: root.status-text;
        status-label: root.status-label;
        status-icon: root.status-icon;
        status-kind: root.status-kind;
        endpoint-summary: root.endpoint-summary;
        server-summary: root.server-summary;
        protocol-summary: root.protocol-summary;
        role-summary: root.role-summary;
        scopes-summary: root.scopes-summary;
        health-summary: root.health-summary;
        identity-summary: root.identity-summary;
        error-message: root.error-message;
        error-action: root.error-action;
        busy: root.busy;
        can-connect: root.can-connect;
        can-cancel: root.can-cancel;
        can-disconnect: root.can-disconnect;
        can-retry: root.can-retry;
        endpoint-input <=> root.endpoint-input;
        endpoint-reset-selector: root.endpoint-reset-selector;
        endpoint-preserve-focus: root.endpoint-preserve-focus;
        token-input <=> root.token-input;
        token-reset-selector: root.token-reset-selector;
        token-preserve-focus: root.token-preserve-focus;
        consent-checked <=> root.consent-checked;
        connect-requested(endpoint, token, consent) => {
            root.connect-requested(endpoint, token, consent);
        }
        retry-requested(endpoint, token, consent) => {
            root.retry-requested(endpoint, token, consent);
        }
        preview-requested => { root.preview-requested(); }
        cancel-requested => { root.cancel-requested(); }
        disconnect-requested => { root.disconnect-requested(); }
        error-dismiss-requested => { root.error-dismiss-requested(); }
        focus-changed(endpoint-focused, token-focused, focused-action) => {
            root.onboarding-endpoint-has-focus = endpoint-focused;
            root.onboarding-token-has-focus = token-focused;
            root.connection-focused-action = focused-action;
        }
        summary-geometry-changed(text-bounds-fit, high-density-stacked) => {
            root.gateway-summary-text-bounds-fit = text-bounds-fit;
            root.gateway-summary-high-density-stacked = high-density-stacked;
        }
    }

    if (root.product-preview-open) : ProductShell {
        width: 100%;
        height: 100%;
        available-width: root.layout-width;
        selected-screen: root.selected-screen;
        selected-settings-section: root.selected-settings-section;
        palette-open: root.palette-open;
        palette-query <=> root.palette-query;
        palette-commands: root.palette-commands;
        palette-selected-index: root.palette-selected-index;
        palette-command-count: root.palette-command-count;
        palette-selected-action-id: root.palette-selected-action-id;
        palette-selected-label: root.palette-selected-label;
        palette-focused-command-index <=> root.palette-focused-command-index;
        diff-mode: root.diff-mode;
        runs: root.runs;
        workspaces: root.workspaces;
        schedules: root.schedules;
        deliverables: root.deliverables;
        extensions: root.extensions;
        transcript: root.transcript;
        activity: root.activity;
        diff-lines: root.diff-lines;
        session-files: root.session-files;
        selected-file-index: root.selected-file-index;
        selected-file-name: root.selected-file-name;
        session-title: root.session-title;
        session-state: root.session-state;
        session-detail: root.session-detail;
        session-tone: root.session-tone;
        can-approve: root.can-approve;
        can-answer: root.can-answer;
        approval-prompt: root.approval-prompt;
        approval-scope: root.approval-scope;
        question: root.question;
        selected-deliverable-index: root.selected-deliverable-index;
        selected-deliverable-name: root.selected-deliverable-name;
        selected-deliverable-kind: root.selected-deliverable-kind;
        selected-deliverable-source: root.selected-deliverable-source;
        selected-deliverable-size: root.selected-deliverable-size;
        selected-deliverable-content: root.selected-deliverable-content;
        selected-deliverable-pinned: root.selected-deliverable-pinned;
        run-page-label: root.run-page-label;
        can-previous-run-page: root.can-previous-run-page;
        can-next-run-page: root.can-next-run-page;
        focused-run-index <=> root.focused-run-index;
        product-interactions-enabled: root.product-interactions-enabled;
        session-narrow-layout: root.session-narrow-layout;
        dashboard-awaiting-review: root.dashboard-awaiting-review;
        dashboard-running: root.dashboard-running;
        dashboard-blocked: root.dashboard-blocked;
        dashboard-workspaces: root.dashboard-workspaces;
        gateway-status-text: root.status-text;
        gateway-status-label: root.status-label;
        gateway-status-icon: root.status-icon;
        gateway-status-kind: root.status-kind;
        gateway-server: root.server-summary;
        gateway-role: root.role-summary;
        gateway-scopes: root.scopes-summary;
        gateway-health: root.health-summary;
        navigate-requested(index) => { root.navigate-requested(index); }
        palette-toggle-requested => { root.palette-toggle-requested(); }
        palette-dismiss-requested => { root.palette-dismiss-requested(); }
        palette-query-changed(query) => { root.palette-query-changed(query); }
        palette-selection-step-requested(step) => { root.palette-selection-step-requested(step); }
        palette-selection-index-requested(index) => { root.palette-selection-index-requested(index); }
        palette-command-requested(action-id) => { root.palette-command-requested(action-id); }
        open-session-requested(index) => { root.open-session-requested(index); }
        open-workspace-requested(index) => { root.open-workspace-requested(index); }
        settings-section-requested(index) => { root.settings-section-requested(index); }
        disconnect-requested => { root.disconnect-requested(); }
        update-requested => { root.update-requested(); }
        diagnostics-requested => { root.diagnostics-requested(); }
        back-requested => { root.back-requested(); }
        diff-mode-requested(mode) => { root.diff-mode-requested(mode); }
        previous-run-page-requested => { root.previous-run-page-requested(); }
        next-run-page-requested => { root.next-run-page-requested(); }
        approval-requested(approved) => { root.approval-requested(approved); }
        answer-requested(answer) => { root.answer-requested(answer); }
        message-submitted(message) => { root.message-submitted(message); }
        file-selected(index) => { root.file-selected(index); }
        schedule-create-requested => { root.schedule-create-requested(); }
        schedule-toggled(index) => { root.schedule-toggled(index); }
        extension-toggled(index) => { root.extension-toggled(index); }
        deliverable-selected(index) => { root.deliverable-selected(index); }
        deliverable-pin-toggle-requested => { root.deliverable-pin-toggle-requested(); }
        palette-trigger-focus-changed(focused) => {
            root.palette-trigger-focused = focused;
        }
        preview-dismiss-trigger-focus-changed(focused) => {
            root.preview-dismiss-trigger-focused = focused;
        }
        appearance-contrast-focus-changed(focused) => {
            root.appearance-contrast-focused = focused;
        }
        approval-geometry-changed(
            text-bounds-fit,
            controls-bounds-fit,
            controls-no-overlap,
            stacked
        ) => {
            root.approval-text-bounds-fit = text-bounds-fit;
            root.approval-controls-bounds-fit = controls-bounds-fit;
            root.approval-controls-no-overlap = controls-no-overlap;
            root.approval-actions-stacked = stacked;
        }
        question-geometry-changed(
            text-bounds-fit,
            controls-bounds-fit,
            controls-no-overlap,
            stacked
        ) => {
            root.question-text-bounds-fit = text-bounds-fit;
            root.question-controls-bounds-fit = controls-bounds-fit;
            root.question-controls-no-overlap = controls-no-overlap;
            root.question-actions-stacked = stacked;
        }
        workspace-card-geometry-changed(
            index,
            text-bounds-fit,
            icon-bounds-fit,
            badge-bounds-fit,
            button-bounds-fit,
            no-overlap,
            stacked
        ) => {
            root.workspace-card-text-bounds-fit = text-bounds-fit;
            root.workspace-card-icon-bounds-fit = icon-bounds-fit;
            root.workspace-card-badge-bounds-fit = badge-bounds-fit;
            root.workspace-card-button-bounds-fit = button-bounds-fit;
            root.workspace-card-no-overlap = no-overlap;
            root.workspace-card-stacked = stacked;
            root.workspace-card-geometry-observed(
                index,
                text-bounds-fit,
                icon-bounds-fit,
                badge-bounds-fit,
                button-bounds-fit,
                no-overlap,
                stacked
            );
        }
        schedule-card-geometry-changed(
            index,
            text-bounds-fit,
            icon-bounds-fit,
            badge-bounds-fit,
            button-bounds-fit,
            no-overlap,
            stacked
        ) => {
            root.schedule-card-text-bounds-fit = text-bounds-fit;
            root.schedule-card-icon-bounds-fit = icon-bounds-fit;
            root.schedule-card-badge-bounds-fit = badge-bounds-fit;
            root.schedule-card-button-bounds-fit = button-bounds-fit;
            root.schedule-card-no-overlap = no-overlap;
            root.schedule-card-stacked = stacked;
            root.schedule-card-geometry-observed(
                index,
                text-bounds-fit,
                icon-bounds-fit,
                badge-bounds-fit,
                button-bounds-fit,
                no-overlap,
                stacked
            );
        }
        extension-card-geometry-changed(
            index,
            text-bounds-fit,
            icon-bounds-fit,
            badge-bounds-fit,
            button-bounds-fit,
            no-overlap,
            stacked
        ) => {
            root.extension-card-text-bounds-fit = text-bounds-fit;
            root.extension-card-icon-bounds-fit = icon-bounds-fit;
            root.extension-card-badge-bounds-fit = badge-bounds-fit;
            root.extension-card-button-bounds-fit = button-bounds-fit;
            root.extension-card-no-overlap = no-overlap;
            root.extension-card-stacked = stacked;
            root.extension-card-geometry-observed(
                index,
                text-bounds-fit,
                icon-bounds-fit,
                badge-bounds-fit,
                button-bounds-fit,
                no-overlap,
                stacked
            );
        }
        session-header-geometry-changed(
            text-bounds-fit,
            back-bounds-fit,
            status-bounds-fit,
            no-overlap,
            stacked
        ) => {
            root.session-header-text-bounds-fit = text-bounds-fit;
            root.session-header-back-bounds-fit = back-bounds-fit;
            root.session-header-status-bounds-fit = status-bounds-fit;
            root.session-header-no-overlap = no-overlap;
            root.session-header-stacked = stacked;
        }
        application-header-geometry-changed(title-bounds-fit, badge-bounds-fit) => {
            root.application-header-title-bounds-fit = title-bounds-fit;
            root.application-header-badge-bounds-fit = badge-bounds-fit;
        }
        settings-rail-geometry-changed(bounds-fit) => {
            root.settings-rail-bounds-fit = bounds-fit;
        }
        viewport-geometry-changed(bounds-fit) => {
            root.product-viewport-bounds-fit = bounds-fit;
        }
        run-focus-visibility-changed(visible) => {
            root.focused-run-visible = visible;
            root.focused-run-visibility-generation += 1;
        }
        background-scroll-position-changed(position) => {
            root.background-scroll-position = position;
        }
        preview-dismiss-requested => { root.preview-dismiss-requested(); }
    }
    }
}
