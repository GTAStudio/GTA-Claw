import { ScrollView } from "std-widgets.slint";
import {
    Card,
    Divider,
    PrimaryButton,
    SecondaryButton,
    StatusBadge,
} from "./primitives.slint";
import { DesignTokens, Metrics, StatusKind } from "./tokens.slint";

component StepMarker {
    in property <int> number;
    in property <string> label;
    in property <int> current-step;
    in property <int> total-steps: 3;

    accessible-role: text;
    accessible-label: "Step " + root.number + " of " + root.total-steps + ", " + root.label + ", "
        + (root.number < root.current-step
            ? "completed"
            : (root.number == root.current-step ? "current step" : "not started"));

    HorizontalLayout {
        spacing: Metrics.space-2;
        alignment: center;

        Rectangle {
            width: Metrics.control-small;
            height: Metrics.control-small;
            horizontal-stretch: 0;
            background: root.number <= root.current-step
                ? DesignTokens.accent
                : DesignTokens.surface-subtle;
            border-width: 1px;
            border-color: root.number <= root.current-step
                ? DesignTokens.accent
                : DesignTokens.border-default;
            border-radius: Metrics.radius-pill;

            Text {
                text: root.number < root.current-step ? "OK" : root.number;
                color: root.number <= root.current-step
                    ? DesignTokens.accent-on
                    : DesignTokens.text-muted;
                font-size: Metrics.type-caption;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }

        Text {
            text: root.label;
            color: root.number == root.current-step
                ? DesignTokens.text-primary
                : DesignTokens.text-muted;
            font-size: Metrics.type-small;
            font-weight: root.number == root.current-step ? 700 : 500;
            accessible-role: none;
        }
    }
}

component PermissionRow {
    in property <string> title;
    in property <string> detail;
    in property <string> value;

    min-height: max(50px, content.min-height);
    accessible-role: region;
    accessible-label: root.title + ". " + root.detail + " Decision: " + root.value;

    content := HorizontalLayout {
        spacing: Metrics.space-3;
        cross-axis-alignment: center;

        VerticalLayout {
            spacing: Metrics.space-1;

            Text {
                text: root.title;
                color: DesignTokens.text-primary;
                font-size: Metrics.type-small;
                font-weight: 700;
                accessible-role: none;
            }

            Text {
                text: root.detail;
                color: DesignTokens.text-muted;
                font-size: Metrics.type-caption;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        Rectangle { horizontal-stretch: 1; }

        Text {
            text: root.value;
            color: DesignTokens.text-secondary;
            font-size: Metrics.type-caption;
            font-weight: 650;
            accessible-role: none;
        }
    }
}

export component FirstRunSurface inherits FocusScope {
    in property <int> stage: 0;
    in property <length> available-width;
    out property <bool> narrow-layout: root.available-width < 860px;

    callback stage-requested(int);

    accessible-role: main;
    accessible-label: root.stage == 0
        ? @tr("Welcome to GTA Claw")
        : (root.stage == 1
            ? @tr("Account authorization availability")
            : @tr("Workspace trust availability"));

    // Created on demand, so take focus to keep the Escape shortcut live.
    init => { root.focus(); }

    key-pressed(event) => {
        if (event.text == Key.Escape && root.stage > 0) {
            root.stage-requested(root.stage - 1);
            return accept;
        }
        return reject;
    }

    Rectangle { background: DesignTokens.surface-app; }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: max(68px, Metrics.control-large + 2 * Metrics.space-3);
            vertical-stretch: 0;
            background: DesignTokens.surface-pane;
            border-width: 1px;
            border-color: DesignTokens.border-default;
            accessible-role: banner;
            accessible-label: "GTA Claw setup, step " + (root.stage + 1) + " of 3";

            HorizontalLayout {
                padding-left: Metrics.space-6;
                padding-right: Metrics.space-6;
                spacing: Metrics.space-3;
                cross-axis-alignment: center;

                Rectangle {
                    width: Metrics.control-large;
                    height: Metrics.control-large;
                    horizontal-stretch: 0;
                    background: DesignTokens.accent;
                    border-radius: Metrics.radius-large;

                    Text {
                        text: "GC";
                        color: DesignTokens.accent-on;
                        font-size: Metrics.type-small;
                        font-weight: 850;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        accessible-role: none;
                    }
                }

                VerticalLayout {
                    spacing: 0px;

                    Text {
                        text: "GTA Claw";
                        color: DesignTokens.text-primary;
                        font-size: Metrics.type-title;
                        font-weight: 800;
                        accessible-role: none;
                    }

                    Text {
                        text: @tr("Native Gateway client");
                        color: DesignTokens.text-muted;
                        font-size: Metrics.type-caption;
                        accessible-role: none;
                    }
                }

                Rectangle { horizontal-stretch: 1; }

                StatusBadge {
                    kind: StatusKind.info;
                    text: "Setup " + (root.stage + 1) + " of 3";
                    semantic-label: "Setup progress";
                    icon-text: root.stage + 1;
                }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            viewport-width: self.width;
            viewport-height: body.min-height;

            body := VerticalLayout {
                width: parent.width;
                padding: root.narrow-layout ? Metrics.space-4 : Metrics.space-8;
                spacing: Metrics.space-6;
                alignment: start;

                Rectangle {
                    width: min(900px, parent.width);
                    horizontal-stretch: 0;
                    min-height: step-row.min-height;

                    accessible-role: list;
                    accessible-label: "Setup steps";
                    accessible-item-count: 3;

                    step-row := HorizontalLayout {
                        spacing: root.narrow-layout ? Metrics.space-3 : Metrics.space-8;
                        alignment: center;

                        StepMarker { number: 1; label: @tr("Welcome"); current-step: root.stage + 1; }
                        Divider { horizontal-stretch: 1; }
                        StepMarker { number: 2; label: @tr("Account"); current-step: root.stage + 1; }
                        Divider { horizontal-stretch: 1; }
                        StepMarker { number: 3; label: @tr("Workspace"); current-step: root.stage + 1; }
                    }
                }

                if (root.stage == 0) : Card {
                    width: min(900px, parent.width);
                    horizontal-stretch: 0;
                    accessible-name: "Welcome";

                    Text {
                        text: @tr("Connect this desktop app to a Gateway");
                        color: DesignTokens.text-primary;
                        font-size: Metrics.type-display;
                        font-weight: 850;
                        wrap: word-wrap;
                        accessible-role: text;
                    }

                    Text {
                        text: @tr("The wired desktop path performs a bounded Gateway connection, authentication, protocol negotiation, and health probe. Account authorization and workspace trust are not composed yet.");
                        color: DesignTokens.text-secondary;
                        font-size: Metrics.type-body;
                        wrap: word-wrap;
                        accessible-role: text;
                    }

                    Divider { }

                    PermissionRow {
                        title: @tr("Gateway diagnostic");
                        detail: @tr("Connect with an endpoint and optional pre-authorized session token.");
                        value: @tr("Available");
                    }
                    PermissionRow {
                        title: @tr("Account authorization");
                        detail: @tr("No desktop device-authorization flow is wired.");
                        value: @tr("Unavailable");
                    }
                    PermissionRow {
                        title: @tr("Workspace trust");
                        detail: @tr("No trusted-path store or workspace selector is wired.");
                        value: @tr("Unavailable");
                    }

                    HorizontalLayout {
                        alignment: end;

                        PrimaryButton {
                            text: @tr("Review setup limits");
                            accessible-name: @tr("Review unavailable account authorization");
                            clicked => { root.stage-requested(1); }
                        }
                    }
                }

                if (root.stage == 1) : Card {
                    width: min(900px, parent.width);
                    horizontal-stretch: 0;
                    accessible-name: @tr("Account authorization availability");

                    Text {
                        text: @tr("Account authorization isn't available");
                        color: DesignTokens.text-primary;
                        font-size: Metrics.type-display;
                        font-weight: 850;
                        accessible-role: text;
                    }

                    Text {
                        text: @tr("This desktop client has no device-authorization backend. No browser flow was started and no one-time code was issued.");
                        color: DesignTokens.text-secondary;
                        font-size: Metrics.type-body;
                        wrap: word-wrap;
                        accessible-role: text;
                    }

                    Rectangle {
                        min-height: max(96px, unavailable-account-copy.min-height + 2 * Metrics.space-4);
                        background: DesignTokens.warning-surface;
                        border-width: 1px;
                        border-color: DesignTokens.warning;
                        border-radius: Metrics.radius-large;
                        accessible-role: text;
                        accessible-label: unavailable-account-copy.text;

                        unavailable-account-copy := Text {
                            x: Metrics.space-4;
                            y: Metrics.space-4;
                            width: parent.width - 2 * Metrics.space-4;
                            text: @tr("To continue, use a pre-authorized Gateway session token or configure authorization outside this desktop app, then proceed to the connection step.");
                            color: DesignTokens.text-primary;
                            font-size: Metrics.type-small;
                            wrap: word-wrap;
                            accessible-role: none;
                        }
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-3;
                        alignment: end;

                        SecondaryButton {
                            text: @tr("Back");
                            accessible-name: @tr("Back to welcome");
                            clicked => { root.stage-requested(0); }
                        }
                        PrimaryButton {
                            text: @tr("Continue without account authorization");
                            accessible-name: @tr("Review unavailable workspace trust");
                            clicked => { root.stage-requested(2); }
                        }
                    }
                }

                if (root.stage == 2) : Card {
                    width: min(900px, parent.width);
                    horizontal-stretch: 0;
                    accessible-name: @tr("Workspace trust availability");

                    Text {
                        text: @tr("Workspace trust isn't available");
                        color: DesignTokens.text-primary;
                        font-size: Metrics.type-display;
                        font-weight: 850;
                        accessible-role: text;
                    }

                    Text {
                        text: @tr("This desktop client has no workspace selector or trust store. No directory was selected and no file or command permission was granted.");
                        color: DesignTokens.text-secondary;
                        font-size: Metrics.type-body;
                        wrap: word-wrap;
                        accessible-role: text;
                    }

                    Rectangle {
                        min-height: max(96px, unavailable-workspace-copy.min-height + 2 * Metrics.space-4);
                        background: DesignTokens.warning-surface;
                        border-width: 1px;
                        border-color: DesignTokens.warning;
                        border-radius: Metrics.radius-medium;
                        accessible-role: text;
                        accessible-label: unavailable-workspace-copy.text;

                        unavailable-workspace-copy := Text {
                            x: Metrics.space-4;
                            y: Metrics.space-4;
                            width: parent.width - 2 * Metrics.space-4;
                            text: @tr("Continue only to run the Gateway diagnostic. Configure workspace trust through a supported host workflow before allowing workspace access.");
                            color: DesignTokens.text-primary;
                            font-size: Metrics.type-small;
                            wrap: word-wrap;
                            accessible-role: none;
                        }
                    }

                    PermissionRow {
                        title: @tr("Trusted path");
                        detail: @tr("No workspace path is loaded.");
                        value: @tr("Unavailable");
                    }
                    PermissionRow {
                        title: @tr("File access");
                        detail: @tr("No read or write grant was created.");
                        value: @tr("Unavailable");
                    }
                    PermissionRow {
                        title: @tr("Command execution");
                        detail: @tr("No workspace command policy was created.");
                        value: @tr("Unavailable");
                    }

                    HorizontalLayout {
                        spacing: Metrics.space-3;
                        alignment: end;

                        SecondaryButton {
                            text: @tr("Back");
                            accessible-name: @tr("Back to account authorization");
                            clicked => { root.stage-requested(1); }
                        }
                        PrimaryButton {
                            text: @tr("Continue to Gateway connection");
                            accessible-name: @tr("Continue to the wired Gateway diagnostic");
                            clicked => { root.stage-requested(3); }
                        }
                    }
                }
            }
        }
    }
}
