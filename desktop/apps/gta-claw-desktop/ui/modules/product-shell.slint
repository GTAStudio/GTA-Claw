import { ListView, ScrollView } from "std-widgets.slint";
import {
    Card,
    ComposerShell,
    DangerButton,
    Divider,
    FocusHistory,
    ModalSheetShell,
    NavigationItem,
    PrimaryButton,
    SecondaryButton,
    StatusBadge,
    TextField,
    ToolbarIconButton,
} from "./primitives.slint";
import { DesignTokens, Metrics, StatusKind, ThemeMode, VisualPreferences } from "./tokens.slint";

export struct RunItem {
    id: string,
    title: string,
    workspace: string,
    state: string,
    detail: string,
    updated: string,
    tone: int,
}

export struct WorkspaceItem {
    name: string,
    location: string,
    kind: string,
    branch: string,
    active-runs: int,
}

export struct ScheduleItem {
    name: string,
    cadence: string,
    next-run: string,
    enabled: bool,
    configured: bool,
    state: string,
    can-toggle: bool,
    workspace: string,
}

export struct FileItem {
    name: string,
    status: string,
}

export struct CommandItem {
    action-id: int,
    glyph: string,
    title: string,
    detail: string,
    keywords: string,
}

export struct DeliverableItem {
    name: string,
    kind: string,
    source: string,
    size: string,
    pinned: bool,
}

export struct ExtensionItem {
    name: string,
    category: string,
    detail: string,
    permission: string,
    enabled: bool,
}

export struct TranscriptItem {
    role: string,
    text: string,
    detail: string,
    timestamp: string,
    tone: int,
}

export struct ActivityItem {
    title: string,
    detail: string,
    state: string,
    duration: string,
    tone: int,
}

export struct DiffItem {
    old-line: string,
    new-line: string,
    text: string,
    old-text: string,
    new-text: string,
    kind: int,
}

component SemanticBadge inherits StatusBadge {
    in property <int> tone: 0;
    kind: root.tone == 4
        ? StatusKind.success
        : (root.tone == 3
            ? StatusKind.danger
            : (root.tone == 2
                ? StatusKind.warning
                : (root.tone == 1 ? StatusKind.info : StatusKind.neutral)));
}

component SectionTitle {
    in property <string> eyebrow;
    in property <string> title;
    in property <string> detail;

    VerticalLayout {
        spacing: Metrics.space-1;

        Text {
            text: root.eyebrow;
            color: DesignTokens.accent;
            font-size: Metrics.type-caption;
            font-weight: 800;
            accessible-role: text;
        }

        Text {
            text: root.title;
            color: DesignTokens.text-primary;
            font-size: Metrics.type-display;
            font-weight: 850;
            wrap: word-wrap;
            accessible-role: text;
        }

        Text {
            text: root.detail;
            color: DesignTokens.text-secondary;
            font-size: Metrics.type-small;
            wrap: word-wrap;
            accessible-role: text;
        }
    }
}

component PreviewCard {
    in property <string> glyph;
    in property <string> title;
    in property <string> detail;
    in property <string> metadata;
    in property <string> badge;
    in property <int> badge-tone;
    in property <string> action-text;
    in property <string> action-name;
    in property <string> action-focus-id;
    in property <bool> action-enabled: true;
    out property <bool> stacked: VisualPreferences.density-scale > 1.25
        || root.width < 760px;
    out property <bool> text-bounds-fit:
        root.width > 0px
        && root.height > 0px
        && card-layout.width > 0px
        && card-layout.height > 0px
        && card-copy.width > 0px
        && card-copy.height > 0px
        && title-text.width > 0px
        && title-text.height > 0px
        && title-text.preferred-height > 0px
        && title-text.height >= title-text.preferred-height
        && detail-text.width > 0px
        && detail-text.height > 0px
        && detail-text.preferred-height > 0px
        && detail-text.height >= detail-text.preferred-height
        && metadata-text.width > 0px
        && metadata-text.height > 0px
        && metadata-text.preferred-height > 0px
        && metadata-text.height >= metadata-text.preferred-height
        && title-text.absolute-position.x >= card-copy.absolute-position.x
        && detail-text.absolute-position.x >= card-copy.absolute-position.x
        && metadata-text.absolute-position.x >= card-copy.absolute-position.x
        && title-text.absolute-position.y >= card-copy.absolute-position.y
        && detail-text.absolute-position.y >= card-copy.absolute-position.y
        && metadata-text.absolute-position.y >= card-copy.absolute-position.y
        && title-text.absolute-position.x + title-text.width
            <= card-copy.absolute-position.x + card-copy.width + 1px
        && detail-text.absolute-position.x + detail-text.width
            <= card-copy.absolute-position.x + card-copy.width + 1px
        && metadata-text.absolute-position.x + metadata-text.width
            <= card-copy.absolute-position.x + card-copy.width + 1px
        && title-text.absolute-position.y + title-text.height
            <= card-copy.absolute-position.y + card-copy.height + 1px
        && detail-text.absolute-position.y + detail-text.height
            <= card-copy.absolute-position.y + card-copy.height + 1px
        && metadata-text.absolute-position.y + metadata-text.height
            <= card-copy.absolute-position.y + card-copy.height + 1px;
    out property <bool> icon-bounds-fit:
        card-icon.width > 0px
        && card-icon.height > 0px
        && icon-text.width > 0px
        && icon-text.height > 0px
        && card-icon.absolute-position.x >= card-layout.absolute-position.x
        && card-icon.absolute-position.y >= card-layout.absolute-position.y
        && card-icon.absolute-position.x + card-icon.width
            <= root.absolute-position.x + root.width - Metrics.space-4 + 1px
        && card-icon.absolute-position.y + card-icon.height
            <= root.absolute-position.y + root.height - Metrics.space-4 + 1px
        && icon-text.width >= icon-text.preferred-width
        && icon-text.height >= icon-text.preferred-height
        && icon-text.absolute-position.x >= card-icon.absolute-position.x
        && icon-text.absolute-position.y >= card-icon.absolute-position.y
        && icon-text.absolute-position.x + icon-text.width
            <= card-icon.absolute-position.x + card-icon.width + 1px
        && icon-text.absolute-position.y + icon-text.height
            <= card-icon.absolute-position.y + card-icon.height + 1px;
    out property <bool> button-bounds-fit:
        card-action.width > 0px
        && card-action.height > 0px
        && card-action.content-bounds-fit
        && card-action.absolute-position.x >= card-layout.absolute-position.x
        && card-action.absolute-position.y >= card-layout.absolute-position.y
        && card-action.absolute-position.x + card-action.width
            <= root.absolute-position.x + root.width - Metrics.space-4 + 1px
        && card-action.absolute-position.y + card-action.height
            <= root.absolute-position.y + root.height - Metrics.space-4 + 1px;
    out property <bool> badge-bounds-fit:
        card-badge.width > 0px
        && card-badge.height > 0px
        && card-badge.content-bounds-fit
        && card-badge.absolute-position.x >= card-layout.absolute-position.x
        && card-badge.absolute-position.y >= card-layout.absolute-position.y
        && card-badge.absolute-position.x + card-badge.width
            <= root.absolute-position.x + root.width - Metrics.space-4 + 1px
        && card-badge.absolute-position.y + card-badge.height
            <= root.absolute-position.y + root.height - Metrics.space-4 + 1px;
    out property <bool> no-overlap: root.stacked
        ? card-icon.absolute-position.y + card-icon.height
                <= card-copy.absolute-position.y + 1px
            && card-copy.absolute-position.y + card-copy.height
                <= card-badge.absolute-position.y + 1px
            && card-badge.absolute-position.y + card-badge.height
                <= card-action.absolute-position.y + 1px
        : card-icon.absolute-position.x + card-icon.width
                <= card-copy.absolute-position.x + 1px
            && card-copy.absolute-position.x + card-copy.width
                <= card-badge.absolute-position.x + 1px
            && card-badge.absolute-position.x + card-badge.width
                <= card-action.absolute-position.x + 1px;
    private property <bool> observed-text-bounds-fit: root.text-bounds-fit;
    private property <bool> observed-icon-bounds-fit: root.icon-bounds-fit;
    private property <bool> observed-button-bounds-fit: root.button-bounds-fit;
    private property <bool> observed-badge-bounds-fit: root.badge-bounds-fit;
    private property <bool> observed-no-overlap: root.no-overlap;
    private property <bool> observed-stacked: root.stacked;
    callback action-requested;
    callback geometry-changed(bool, bool, bool, bool, bool, bool);

    min-height: card-layout.min-height + 2 * Metrics.space-4;
    accessible-role: region;
    accessible-label: root.title + ". " + root.detail + ". " + root.metadata;

    function report-geometry() {
        root.geometry-changed(
            root.text-bounds-fit,
            root.icon-bounds-fit,
            root.badge-bounds-fit,
            root.button-bounds-fit,
            root.no-overlap,
            root.stacked
        );
    }

    init => { root.report-geometry(); }
    changed observed-text-bounds-fit => { root.report-geometry(); }
    changed observed-icon-bounds-fit => { root.report-geometry(); }
    changed observed-button-bounds-fit => { root.report-geometry(); }
    changed observed-badge-bounds-fit => { root.report-geometry(); }
    changed observed-no-overlap => { root.report-geometry(); }
    changed observed-stacked => { root.report-geometry(); }

    Rectangle {
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border-default;
        border-radius: Metrics.radius-large;
    }

    card-layout := GridLayout {
        x: Metrics.space-4;
        y: Metrics.space-4;
        width: parent.width - 2 * Metrics.space-4;
        spacing: Metrics.space-3;

        card-icon := Rectangle {
            row: 0;
            col: 0;
            width: Metrics.control-large;
            height: Metrics.control-large;
            horizontal-stretch: 0;
            background: DesignTokens.accent-surface;
            border-radius: Metrics.radius-medium;

            icon-text := Text {
                text: root.glyph;
                color: DesignTokens.accent;
                font-size: Metrics.type-small;
                font-weight: 850;
                horizontal-alignment: center;
                vertical-alignment: center;
                accessible-role: none;
            }
        }

        card-copy := VerticalLayout {
            row: root.stacked ? 1 : 0;
            col: root.stacked ? 0 : 1;
            min-width: 0px;
            horizontal-stretch: 1;
            spacing: Metrics.space-1;

            title-text := Text {
                text: root.title;
                color: DesignTokens.text-primary;
                font-size: Metrics.type-title;
                font-weight: 800;
                wrap: word-wrap;
                accessible-role: none;
            }
            detail-text := Text {
                text: root.detail;
                color: DesignTokens.text-secondary;
                font-size: Metrics.type-small;
                wrap: word-wrap;
                accessible-role: none;
            }
            metadata-text := Text {
                text: root.metadata;
                color: DesignTokens.text-muted;
                font-size: Metrics.type-caption;
                wrap: word-wrap;
                accessible-role: none;
            }
        }

        card-badge := SemanticBadge {
            row: root.stacked ? 2 : 0;
            col: root.stacked ? 0 : 2;
            text: root.badge;
            tone: root.badge-tone;
        }

        card-action := SecondaryButton {
            row: root.stacked ? 3 : 0;
            col: root.stacked ? 0 : 3;
            horizontal-stretch: root.stacked ? 1 : 0;
            text: root.action-text;
            accessible-name: root.action-name;
            focus-id: root.action-focus-id;
            enabled: root.action-enabled;
            clicked => { root.action-requested(); }
        }
    }
}

component MetricCard {
    in property <string> value;
    in property <string> label;
    in property <string> detail;
    in property <int> tone;

    min-height: max(
        112px,
        Metrics.line-title + Metrics.line-body + 2 * Metrics.line-caption + 2 * Metrics.space-3
    );
    accessible-role: region;
    accessible-label: root.label + ": " + root.value + ". " + root.detail;

    Rectangle {
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: root.tone == 3
            ? DesignTokens.danger
            : (root.tone == 2 ? DesignTokens.warning : DesignTokens.border-default);
        border-radius: Metrics.radius-large;

        VerticalLayout {
            padding: Metrics.space-3;
            spacing: Metrics.space-1;

            Text {
                text: root.value;
                color: root.tone == 3
                    ? DesignTokens.danger
                    : (root.tone == 2 ? DesignTokens.warning : DesignTokens.text-primary);
                font-size: Metrics.type-display;
                font-weight: 850;
                accessible-role: none;
            }
            Text {
                text: root.label;
                color: DesignTokens.text-primary;
                font-size: Metrics.type-small;
                font-weight: 700;
                accessible-role: none;
            }
            Text {
                text: root.detail;
                color: DesignTokens.text-muted;
                font-size: Metrics.type-caption;
                wrap: word-wrap;
                accessible-role: none;
            }
        }
    }
}

component LifecycleLegend {
    accessible-role: region;
    accessible-label: "All twelve supported run states";
    // Twelve static badges that never change once laid out.
    cache-rendering-hint: true;

    if (VisualPreferences.density-scale <= 1.25) : GridLayout {
        spacing: Metrics.space-2;

        Row {
            SemanticBadge { text: "Draft"; tone: 0; }
            SemanticBadge { text: "Queued"; tone: 0; }
            SemanticBadge { text: "Starting"; tone: 1; }
            SemanticBadge { text: "Running"; tone: 1; }
        }
        Row {
            SemanticBadge { text: "Waiting for approval"; tone: 2; }
            SemanticBadge { text: "Waiting for answer"; tone: 1; }
            SemanticBadge { text: "Paused"; tone: 0; }
            SemanticBadge { text: "Blocked"; tone: 2; }
        }
        Row {
            SemanticBadge { text: "Failed"; tone: 3; }
            SemanticBadge { text: "Cancelled"; tone: 0; }
            SemanticBadge { text: "Completed"; tone: 4; }
            SemanticBadge { text: "Completed with changes"; tone: 4; }
        }
    }

    if (VisualPreferences.density-scale > 1.25) : VerticalLayout {
        spacing: Metrics.space-2;
        SemanticBadge { text: "Draft"; tone: 0; }
        SemanticBadge { text: "Queued"; tone: 0; }
        SemanticBadge { text: "Starting"; tone: 1; }
        SemanticBadge { text: "Running"; tone: 1; }
        SemanticBadge { text: "Waiting for approval"; tone: 2; }
        SemanticBadge { text: "Waiting for answer"; tone: 1; }
        SemanticBadge { text: "Paused"; tone: 0; }
        SemanticBadge { text: "Blocked"; tone: 2; }
        SemanticBadge { text: "Failed"; tone: 3; }
        SemanticBadge { text: "Cancelled"; tone: 0; }
        SemanticBadge { text: "Completed"; tone: 4; }
        SemanticBadge { text: "Completed with changes"; tone: 4; }
    }
}

component RunList {
    in property <[RunItem]> runs;
    in-out property <int> focused-index: -1;
    callback open-requested(int);
    callback focus-reveal-requested(length, length);
    private property <bool> stacked-row: root.width < 800px
        || VisualPreferences.density-scale > 1.25;
    private property <length> row-height: root.stacked-row
        ? max(148px, Metrics.control-large + Metrics.line-body + 2 * Metrics.line-caption + 3 * Metrics.space-2)
        : max(76px, Metrics.control-large + 2 * Metrics.space-3);
    out property <length> focused-row-y: root.focused-index < 0
        ? 0px
        : run-list.viewport-y + root.focused-index * root.row-height;
    out property <length> focused-row-height: root.row-height;
    out property <bool> focused-row-visible: root.focused-index < 0
        || (root.row-height > 0px
            && run-list.width > 0px
            && run-list.visible-height > 0px
            && root.focused-row-y >= -1px
            && root.focused-row-y + root.row-height <= run-list.visible-height + 1px
            && run-list.absolute-position.y + root.focused-row-y
                >= run-list.absolute-position.y - 1px
            && run-list.absolute-position.y + root.focused-row-y + root.row-height
                <= run-list.absolute-position.y + run-list.visible-height + 1px);

    accessible-role: none;

    // Slint 1.17.1 returns FocusIgnored when Tab reaches a virtual row that has
    // not been instantiated. The page is bounded at 24 rows, so instantiate the
    // page and move the Flickable viewport explicitly in both directions.
    function reveal-row(index: int) {
        let row-y = run-list.viewport-y + index * root.row-height;
        if (row-y < 0px) {
            run-list.viewport-y -= row-y;
        } else if (row-y + root.row-height > run-list.visible-height) {
            run-list.viewport-y -= row-y + root.row-height - run-list.visible-height;
        }
    }

    run-list := ScrollView {
        viewport-width: self.width;
        viewport-height: run-rows.min-height;

        run-rows := VerticalLayout {
            width: parent.width;
            accessible-role: list;
            accessible-label: "Runs";
            accessible-item-count: root.runs.length;

            for run[index] in root.runs : Rectangle {
                height: root.row-height;
                accessible-role: list-item;
                accessible-label: run.title + ", " + run.state + ", " + run.workspace + ", " + run.detail + ", updated " + run.updated;
                accessible-item-index: index;
                accessible-item-count: root.runs.length;
                background: Math.mod(index, 2) == 0
                    ? DesignTokens.surface-raised
                    : DesignTokens.surface-pane;
                border-width: 1px;
                border-color: DesignTokens.border-default;
                border-radius: Metrics.radius-medium;

                if (!root.stacked-row) : HorizontalLayout {
                    padding: Metrics.space-3;
                    spacing: Metrics.space-3;
                    alignment: center;

                    VerticalLayout {
                        spacing: Metrics.space-1;

                        HorizontalLayout {
                            spacing: Metrics.space-2;
                            alignment: center;

                            Text {
                                text: run.title;
                                color: DesignTokens.text-primary;
                                font-size: Metrics.type-small;
                                font-weight: 750;
                                overflow: elide;
                                accessible-role: none;
                            }
                            SemanticBadge {
                                text: run.state;
                                tone: run.tone;
                            }
                        }

                        Text {
                            text: run.workspace + " · " + run.detail;
                            color: DesignTokens.text-muted;
                            font-size: Metrics.type-caption;
                            overflow: elide;
                            accessible-role: none;
                        }
                    }

                    Text {
                        text: run.updated;
                        color: DesignTokens.text-muted;
                        font-size: Metrics.type-caption;
                        accessible-role: none;
                    }

                    SecondaryButton {
                        text: "Preview";
                        accessible-name: "Open " + run.title + " preview";
                        focus-received => {
                            root.focused-index = index;
                            root.reveal-row(index);
                            root.focus-reveal-requested(
                                run-list.absolute-position.y + root.focused-row-y,
                                root.row-height
                            );
                        }
                        clicked => { root.open-requested(index); }
                    }
                }

                if (root.stacked-row) : VerticalLayout {
                    padding: Metrics.space-2;
                    spacing: Metrics.space-1;

                    HorizontalLayout {
                        spacing: Metrics.space-2;
                        Text {
                            text: run.title;
                            color: DesignTokens.text-primary;
                            font-size: Metrics.type-small;
                            font-weight: 750;
                            overflow: elide;
                            accessible-role: none;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        SecondaryButton {
                            text: "Preview";
                            accessible-name: "Open " + run.title + " preview";
                            focus-received => {
                                root.focused-index = index;
                                root.reveal-row(index);
                                root.focus-reveal-requested(
                                    run-list.absolute-position.y + root.focused-row-y,
                                    root.row-height
                                );
                            }
                            clicked => { root.open-requested(index); }
                        }
                    }
                    SemanticBadge {
                        text: run.state;
                        tone: run.tone;
                    }
                    Text {
                        text: run.workspace + " · " + run.detail;
                        color: DesignTokens.text-muted;
                        font-size: Metrics.type-caption;
                        overflow: elide;
                        accessible-role: none;
                    }
                    Text {
                        text: "Updated " + run.updated;
                        color: DesignTokens.text-muted;
                        font-size: Metrics.type-caption;
                        accessible-role: none;
                    }
                }
            }
        }
    }
}

component FocusScreen {
    in property <[RunItem]> runs;
    in-out property <int> focused-run-index;
    in property <int> awaiting-review;
    in property <int> running;
    in property <int> blocked;
    in property <int> workspace-count;
    callback open-session-requested(int);
    callback focused-run-visibility-changed(bool);
    callback background-scroll-position-changed(length);
    private property <bool> stack-metrics: root.width < 760px
        || VisualPreferences.density-scale > 1.25;
    out property <bool> focused-run-visible: root.focused-run-index < 0
        || (root.width > 0px
            && root.height > 0px
            && focus-scroll.width > 0px
            && focus-scroll.visible-height > 0px
            && focus-run-list.focused-row-visible
            && focus-run-list.absolute-position.y + focus-run-list.focused-row-y
                >= focus-scroll.absolute-position.y - 1px
            && focus-run-list.absolute-position.y + focus-run-list.focused-row-y
                    + focus-run-list.focused-row-height
                <= focus-scroll.absolute-position.y + focus-scroll.visible-height + 1px);
    private property <bool> observed-focused-run-visible: root.focused-run-visible;
    private property <length> observed-background-scroll-position: focus-scroll.viewport-y;

    function reveal-focused-control(item-y: length, item-height: length) {
        let view-top = focus-scroll.absolute-position.y;
        let view-bottom = view-top + focus-scroll.visible-height;
        if (item-y < view-top) {
            focus-scroll.viewport-y += view-top - item-y;
        } else if (item-y + item-height > view-bottom) {
            focus-scroll.viewport-y -= item-y + item-height - view-bottom;
        }
        root.focused-run-visibility-changed(root.focused-run-visible);
    }

    init => {
        root.focused-run-visibility-changed(root.focused-run-visible);
        root.background-scroll-position-changed(focus-scroll.viewport-y);
    }
    changed observed-focused-run-visible => {
        root.focused-run-visibility-changed(root.focused-run-visible);
    }
    changed observed-background-scroll-position => {
        root.background-scroll-position-changed(focus-scroll.viewport-y);
    }

    accessible-role: main;
    accessible-label: "Preview focus overview";

    focus-scroll := ScrollView {
        viewport-width: self.width;
        viewport-height: body.min-height;

        body := VerticalLayout {
            width: parent.width;
            padding: Metrics.space-6;
            spacing: Metrics.space-4;

            SectionTitle {
                eyebrow: "FOCUS";
                title: "Read-only product preview";
                detail: "Sample runs demonstrate the desktop information architecture. They are not live Gateway work.";
            }

            if (!root.stack-metrics) : HorizontalLayout {
                spacing: Metrics.space-3;
                MetricCard { value: "" + root.awaiting-review; label: "Awaiting review"; detail: "Derived from preview runs"; tone: 2; }
                MetricCard { value: "" + root.running; label: "Running"; detail: "Across " + root.workspace-count + " preview workspaces"; tone: 1; }
                MetricCard { value: "" + root.blocked; label: "Blocked"; detail: "Derived from preview runs"; tone: 3; }
            }

            if (root.stack-metrics) : VerticalLayout {
                spacing: Metrics.space-3;
                MetricCard { value: "" + root.awaiting-review; label: "Awaiting review"; detail: "Derived from preview runs"; tone: 2; }
                MetricCard { value: "" + root.running; label: "Running"; detail: "Across " + root.workspace-count + " preview workspaces"; tone: 1; }
                MetricCard { value: "" + root.blocked; label: "Blocked"; detail: "Derived from preview runs"; tone: 3; }
            }

            Card {
                accessible-name: "Run lifecycle coverage";
                Text {
                    text: "Lifecycle at a glance";
                    color: DesignTokens.text-primary;
                    font-size: Metrics.type-small;
                    font-weight: 750;
                    accessible-role: text;
                }
                LifecycleLegend { }
            }

            Text {
                text: "Priority queue";
                color: DesignTokens.text-primary;
                font-size: Metrics.type-title;
                font-weight: 800;
                accessible-role: text;
            }

            focus-run-list := RunList {
                height: 320px;
                runs: root.runs;
                focused-index <=> root.focused-run-index;
                open-requested(index) => { root.open-session-requested(index); }
                focus-reveal-requested(item-y, item-height) => {
                    root.reveal-focused-control(item-y, item-height);
                }
            }
        }
    }
}

component WorkspacesScreen {
    in property <[WorkspaceItem]> workspaces;
    callback open-workspace-requested(int);
    callback card-geometry-changed(int, bool, bool, bool, bool, bool, bool);

    accessible-role: main;
    accessible-label: "Workspaces";

    ScrollView {
        viewport-width: self.width;
        viewport-height: body.min-height;

        body := VerticalLayout {
            width: parent.width;
            padding: Metrics.space-6;
            spacing: Metrics.space-4;

            SectionTitle {
                eyebrow: "WORKSPACES";
                title: @tr("Workspace previews");
                detail: @tr("Workspace trust and discovery are not composed. These rows are product previews and do not represent trusted paths.");
            }

            for workspace[index] in root.workspaces : PreviewCard {
                glyph: workspace.kind == "Remote workspace" ? "R" : "W";
                title: workspace.name;
                detail: workspace.kind + " · " + workspace.location;
                metadata: workspace.branch;
                badge: workspace.active-runs + " active runs";
                badge-tone: workspace.active-runs > 0 ? 1 : 0;
                action-text: @tr("Open preview");
                action-name: @tr("Open {} preview", workspace.name);
                action-focus-id: "workspaces.open." + index;
                action-requested => { root.open-workspace-requested(index); }
                geometry-changed(
                    text-bounds-fit,
                    icon-bounds-fit,
                    badge-bounds-fit,
                    button-bounds-fit,
                    no-overlap,
                    stacked
                ) => {
                    root.card-geometry-changed(
                        index,
                        text-bounds-fit,
                        icon-bounds-fit,
                        badge-bounds-fit,
                        button-bounds-fit,
                        no-overlap,
                        stacked
                    );
                }
            }
        }
    }
}

component RunsScreen {
    in property <[RunItem]> runs;
    in-out property <int> focused-run-index;
    in property <string> page-label;
    in property <bool> can-previous;
    in property <bool> can-next;
    callback open-session-requested(int);
    callback previous-requested;
    callback next-requested;

    accessible-role: main;
    accessible-label: "Run monitor preview";

    VerticalLayout {
        padding: Metrics.space-6;
        spacing: Metrics.space-4;

        SectionTitle {
            eyebrow: "RUN MONITOR";
            title: "Run monitor preview";
            detail: "A bounded sample of lifecycle states. No live or historical runs are loaded.";
        }

        if (VisualPreferences.density-scale <= 1.25) : Card {
            accessible-name: "Supported run states";
            LifecycleLegend { }
        }
        if (VisualPreferences.density-scale > 1.25) : Text {
            text: "All 12 lifecycle states are represented in the bounded preview pages.";
            color: DesignTokens.text-secondary;
            font-size: Metrics.type-caption;
            wrap: word-wrap;
            accessible-role: text;
        }

        RunList {
            vertical-stretch: 1;
            runs: root.runs;
            focused-index <=> root.focused-run-index;
            open-requested(index) => { root.open-session-requested(index); }
        }

        HorizontalLayout {
            spacing: Metrics.space-3;
            alignment: end;
            Text {
                text: root.page-label;
                color: DesignTokens.text-muted;
                font-size: Metrics.type-caption;
                vertical-alignment: center;
                accessible-role: text;
            }
            SecondaryButton {
                text: "Previous";
                enabled: root.can-previous;
                clicked => { root.previous-requested(); }
            }
            SecondaryButton {
                text: "Next";
                enabled: root.can-next;
                clicked => { root.next-requested(); }
            }
        }
    }
}

component SchedulesScreen {
    in property <[ScheduleItem]> schedules;
    in property <bool> interactions-enabled;
    callback create-requested;
    callback toggled(int);
    callback card-geometry-changed(int, bool, bool, bool, bool, bool, bool);

    accessible-role: main;
    accessible-label: "Schedule preview";

    ScrollView {
        viewport-width: self.width;
        viewport-height: body.min-height;

        body := VerticalLayout {
            width: parent.width;
            padding: Metrics.space-6;
            spacing: Metrics.space-4;

            SectionTitle {
                eyebrow: "SCHEDULE MANAGER";
                title: "Schedule preview";
                detail: "Scheduling is not connected. These bounded sample rows cannot be created, enabled, or paused.";
            }

            HorizontalLayout {
                alignment: end;
                PrimaryButton {
                    text: "Creation unavailable";
                    accessible-name: "Schedule creation unavailable in read-only preview";
                    description: "No schedule service or editor is connected.";
                    enabled: root.interactions-enabled;
                    clicked => { root.create-requested(); }
                }
            }

            for schedule[index] in root.schedules : PreviewCard {
                glyph: "S";
                title: schedule.name;
                detail: schedule.cadence + " · " + schedule.workspace;
                metadata: "Next: " + schedule.next-run;
                badge: schedule.state;
                badge-tone: schedule.enabled ? 4 : 0;
                action-text: schedule.enabled ? "Pause" : "Enable";
                action-name: (schedule.enabled ? "Pause " : "Enable ") + schedule.name;
                action-focus-id: "schedules.toggle." + index;
                action-enabled: schedule.can-toggle;
                action-requested => { root.toggled(index); }
                geometry-changed(
                    text-bounds-fit,
                    icon-bounds-fit,
                    badge-bounds-fit,
                    button-bounds-fit,
                    no-overlap,
                    stacked
                ) => {
                    root.card-geometry-changed(
                        index,
                        text-bounds-fit,
                        icon-bounds-fit,
                        badge-bounds-fit,
                        button-bounds-fit,
                        no-overlap,
                        stacked
                    );
                    }
            }
        }
    }
}

component DeliverablesScreen {
    in property <[DeliverableItem]> deliverables;
    in property <int> selected-index;
    in property <string> selected-name;
    in property <string> selected-kind;
    in property <string> selected-source;
    in property <string> selected-size;
    in property <string> selected-content;
    in property <bool> selected-pinned;
    in property <bool> interactions-enabled;
    callback selected(int);
    callback pin-toggle-requested;

    accessible-role: main;
    accessible-label: "Artifact preview";

    ScrollView {
        viewport-width: self.width;
        viewport-height: body.min-height;

        body := VerticalLayout {
            width: parent.width;
            padding: Metrics.space-6;
            spacing: Metrics.space-4;

            SectionTitle {
                eyebrow: "DELIVERABLES";
                title: "Artifact preview";
                detail: "Sample documents and structured data. Pinning and persistence are unavailable.";
            }

            Card {
                accessible-name: "Deliverable list";

                Text {
                    text: "Preview artifacts";
                    color: DesignTokens.text-primary;
                    font-size: Metrics.type-title;
                    font-weight: 800;
                    accessible-role: text;
                }

                for artifact[index] in root.deliverables : NavigationItem {
                    glyph: artifact.pinned ? "P" : "F";
                    text: artifact.name;
                    detail: artifact.kind + " · " + artifact.size;
                    selected: root.selected-index == index;
                    clicked => { root.selected(index); }
                }
            }

            Card {
                accessible-name: "Artifact viewer";

                HorizontalLayout {
                    Text {
                        text: "Artifact viewer";
                        color: DesignTokens.text-primary;
                        font-size: Metrics.type-title;
                        font-weight: 800;
                        accessible-role: text;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SemanticBadge {
                        text: root.selected-pinned ? "Sample pinned state" : "Sample unpinned state";
                        tone: root.selected-pinned ? 4 : 0;
                    }
                }
                Divider { }
                Text {
                    text: root.selected-name;
                    color: DesignTokens.accent;
                    font-size: Metrics.type-small;
                    font-weight: 750;
                    accessible-role: text;
                }
                Text {
                    text: root.selected-kind + " · " + root.selected-size + " · " + root.selected-source;
                    color: DesignTokens.text-muted;
                    font-size: Metrics.type-caption;
                    wrap: word-wrap;
                    accessible-role: text;
                }
                Text {
                    text: root.selected-content;
                    color: DesignTokens.text-secondary;
                    font-size: Metrics.type-small;
                    wrap: word-wrap;
                    accessible-role: text;
                }
                HorizontalLayout {
                    alignment: end;
                    SecondaryButton {
                        text: "Pinning unavailable";
                        accessible-name: "Artifact pinning unavailable in read-only preview";
                        enabled: root.interactions-enabled;
                        clicked => { root.pin-toggle-requested(); }
                    }
                }
            }
        }
    }
}

component ExtensionsScreen {
    in property <[ExtensionItem]> extensions;
    in property <bool> interactions-enabled;
    callback toggled(int);
    callback card-geometry-changed(int, bool, bool, bool, bool, bool, bool);

    accessible-role: main;
    accessible-label: "Extension preview";

    ScrollView {
        viewport-width: self.width;
        viewport-height: body.min-height;

        body := VerticalLayout {
            width: parent.width;
            padding: Metrics.space-6;
            spacing: Metrics.space-4;

            SectionTitle {
                eyebrow: "EXTENSION MANAGER";
                title: "Extension preview";
                detail: "Sample roles, skills, connectors, and permissions. No extension registry is connected.";
            }

            for extension[index] in root.extensions : PreviewCard {
                glyph: extension.category == "Connector"
                    ? "C"
                    : (extension.category == "Skill" ? "S" : (extension.category == "Role" ? "R" : "P"));
                title: extension.name;
                detail: extension.category + " · " + extension.detail;
                metadata: "Permission: " + extension.permission;
                badge: extension.enabled ? "Sample enabled" : "Sample disabled";
                badge-tone: extension.enabled ? 4 : 0;
                action-text: extension.enabled ? "Disable" : "Enable";
                action-name: (extension.enabled ? "Disable " : "Enable ") + extension.name;
                action-focus-id: "extensions.toggle." + index;
                action-enabled: root.interactions-enabled;
                action-requested => { root.toggled(index); }
                geometry-changed(
                    text-bounds-fit,
                    icon-bounds-fit,
                    badge-bounds-fit,
                    button-bounds-fit,
                    no-overlap,
                    stacked
                ) => {
                    root.card-geometry-changed(
                        index,
                        text-bounds-fit,
                        icon-bounds-fit,
                        badge-bounds-fit,
                        button-bounds-fit,
                        no-overlap,
                        stacked
                    );
                }
            }
        }
    }
}

component SettingsScreen {
    in property <int> selected-section;
    in property <bool> compact-navigation;
    in property <string> gateway-status-text;
    in property <string> gateway-status-label;
    in property <string> gateway-status-icon;
    in property <StatusKind> gateway-status-kind;
    in property <string> gateway-server;
    in property <string> gateway-role;
    in property <string> gateway-scopes;
    in property <string> gateway-health;
    callback section-requested(int);
    callback disconnect-requested;
    callback update-requested;
    callback diagnostics-requested;
    callback appearance-contrast-focus-changed(bool);
    callback rail-geometry-changed(bool);
    private property <length> compact-rail-width:
        max(128px, Metrics.control-large + 4 * Metrics.space-3);
    out property <bool> rail-bounds-fit:
        root.width > 0px
        && root.height > 0px
        && settings-rail.width > 0px
        && settings-rail.height > 0px
        && settings-navigation.width > 0px
        && settings-navigation.height > 0px
        && settings-rail.width >= settings-navigation.min-width
        && (!root.compact-navigation
            || settings-rail.width >= root.compact-rail-width)
        && settings-rail.absolute-position.x >= root.absolute-position.x
        && settings-rail.absolute-position.y >= root.absolute-position.y
        && settings-rail.absolute-position.x + settings-rail.width
            <= root.absolute-position.x + root.width + 1px
        && settings-rail.absolute-position.y + settings-rail.height
            <= root.absolute-position.y + root.height + 1px;
    private property <bool> observed-rail-bounds-fit: root.rail-bounds-fit;

    init => { root.rail-geometry-changed(root.rail-bounds-fit); }
    changed observed-rail-bounds-fit => {
        root.rail-geometry-changed(root.rail-bounds-fit);
    }

    function reveal-navigation-item(item-y: length, item-height: length) {
        let view-top = settings-scroll.absolute-position.y;
        let view-bottom = view-top + settings-scroll.visible-height;
        if (item-y < view-top) {
            settings-scroll.viewport-y += view-top - item-y;
        } else if (item-y + item-height > view-bottom) {
            settings-scroll.viewport-y -= item-y + item-height - view-bottom;
        }
    }

    accessible-role: main;
    accessible-label: "Settings";

    HorizontalLayout {
        spacing: 0px;

        settings-rail := Rectangle {
            width: root.compact-navigation
                ? root.compact-rail-width
                : 220px;
            horizontal-stretch: 0;
            background: DesignTokens.surface-pane;
            border-width: 1px;
            border-color: DesignTokens.border-default;

            settings-scroll := ScrollView {
                viewport-width: self.width;
                viewport-height: settings-navigation.min-height;

                settings-navigation := VerticalLayout {
                    width: parent.width;
                    padding: Metrics.space-3;
                    spacing: Metrics.space-1;

                    if (!root.compact-navigation) : Text {
                        text: "Settings";
                        color: DesignTokens.text-primary;
                        font-size: Metrics.type-title;
                        font-weight: 850;
                        accessible-role: text;
                    }
                    NavigationItem { glyph: "A"; text: root.compact-navigation ? "" : "Account"; accessible-name: "Account settings"; selected: root.selected-section == 0; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(0); } }
                    NavigationItem { glyph: "M"; text: root.compact-navigation ? "" : "Models"; accessible-name: "Model settings"; selected: root.selected-section == 1; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(1); } }
                    NavigationItem { glyph: "E"; text: root.compact-navigation ? "" : "Execution"; accessible-name: "Execution settings"; selected: root.selected-section == 2; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(2); } }
                    NavigationItem { glyph: "V"; text: root.compact-navigation ? "" : "Appearance"; accessible-name: "Appearance settings"; selected: root.selected-section == 3; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(3); } }
                    NavigationItem { glyph: "N"; text: root.compact-navigation ? "" : "Notifications"; accessible-name: "Notification settings"; selected: root.selected-section == 4; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(4); } }
                    NavigationItem { glyph: "K"; text: root.compact-navigation ? "" : "Shortcuts"; accessible-name: "Keyboard shortcuts"; selected: root.selected-section == 5; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(5); } }
                    NavigationItem { glyph: "U"; text: root.compact-navigation ? "" : "Updates"; accessible-name: "Update settings"; selected: root.selected-section == 6; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(6); } }
                    NavigationItem { glyph: "D"; text: root.compact-navigation ? "" : "Diagnostics"; accessible-name: "Diagnostic settings"; selected: root.selected-section == 7; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.section-requested(7); } }
                }
            }
        }

        ScrollView {
            horizontal-stretch: 1;
            viewport-width: self.width;
            viewport-height: body.min-height;

            body := VerticalLayout {
                width: parent.width;
                padding: Metrics.space-6;
                spacing: Metrics.space-4;

                SectionTitle {
                    eyebrow: "SETTINGS";
                    title: root.selected-section == 0
                        ? "Account"
                        : (root.selected-section == 1
                            ? "Models"
                            : (root.selected-section == 2
                                ? "Execution"
                                : (root.selected-section == 3
                                    ? "Appearance"
                                    : (root.selected-section == 4
                                        ? "Notifications"
                                        : (root.selected-section == 5
                                            ? "Shortcuts"
                                            : (root.selected-section == 6 ? "Updates" : "Diagnostics"))))));
                    detail: root.selected-section == 0
                        ? "Identity and Gateway session."
                        : (root.selected-section == 1
                            ? "Default models, routing, and context budgets."
                            : (root.selected-section == 2
                                ? "Sandbox, approvals, and concurrency."
                                : (root.selected-section == 3
                                    ? "Theme, contrast, density, and motion."
                                    : (root.selected-section == 4
                                        ? "Attention and completion signals."
                                        : (root.selected-section == 5
                                            ? "Keyboard-first navigation."
                                            : (root.selected-section == 6 ? "Native application releases." : "Runtime health and support data."))))));
                }

                Card {
                    accessible-name: "Selected setting";

                    if (root.selected-section == 0) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: @tr("Gateway session"); color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        StatusBadge {
                            text: root.gateway-status-text;
                            semantic-label: root.gateway-status-label;
                            icon-text: root.gateway-status-icon;
                            kind: root.gateway-status-kind;
                        }
                        Text { text: @tr("Server: {}", root.gateway-server); color: DesignTokens.text-secondary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                        Text { text: @tr("Role: {} · Effective scopes: {}", root.gateway-role, root.gateway-scopes); color: DesignTokens.text-secondary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                        Text { text: @tr("Health probe: {}", root.gateway-health); color: DesignTokens.text-muted; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: text; }
                        DangerButton {
                            text: @tr("Disconnect Gateway");
                            clicked => { root.disconnect-requested(); }
                        }
                    }

                    if (root.selected-section == 1) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: "Model configuration preview"; color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        TextField { label: "Model"; text: "No model backend connected"; read-only: true; }
                        Text { text: "This sample control does not read or update model routing."; color: DesignTokens.text-muted; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: text; }
                    }

                    if (root.selected-section == 2) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: "Execution policy preview"; color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        Text { text: "No command, approval, sandbox, or run service is connected."; color: DesignTokens.text-secondary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                    }

                    if (root.selected-section == 3) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: "Appearance"; color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        Text { text: "Session-only light, dark, high-contrast, 80% to 200% scale, and reduced-motion preferences."; color: DesignTokens.text-secondary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                        Text { text: "Appearance preferences reset when this application closes because no platform preference store is connected."; color: DesignTokens.warning; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: text; }
                        VerticalLayout {
                            spacing: Metrics.space-2;
                            Text {
                                text: "Theme: "
                                    + (VisualPreferences.effective-theme-mode == ThemeMode.light ? "Light" : "Dark")
                                    + (VisualPreferences.theme-override-active ? "" : " (following the system)");
                                color: DesignTokens.text-secondary;
                                font-size: Metrics.type-small;
                                accessible-role: text;
                            }
                            SecondaryButton {
                                text: "Theme";
                                focus-id: "settings.appearance.theme";
                                accessible-name: VisualPreferences.effective-theme-mode == ThemeMode.light
                                    ? "Use dark theme"
                                    : "Use light theme";
                                description: "Overrides the system light and dark setting";
                                clicked => {
                                    VisualPreferences.request-theme-mode(
                                        VisualPreferences.effective-theme-mode == ThemeMode.light ? ThemeMode.dark : ThemeMode.light
                                    );
                                }
                            }
                            SecondaryButton {
                                text: "Match system";
                                accessible-name: "Follow the system light and dark setting";
                                enabled: VisualPreferences.theme-override-active;
                                clicked => {
                                    VisualPreferences.follow-system-theme-requested(VisualPreferences.system-theme-mode);
                                }
                            }
                            Text {
                                text: "High contrast: " + (VisualPreferences.high-contrast ? "On" : "Off");
                                color: DesignTokens.text-secondary;
                                font-size: Metrics.type-small;
                                accessible-role: text;
                            }
                            SecondaryButton {
                                text: "Contrast";
                                focus-id: "settings.appearance.contrast";
                                accessible-name: VisualPreferences.high-contrast ? "Disable high contrast" : "Enable high contrast";
                                checkable: true;
                                checked: VisualPreferences.high-contrast;
                                focus-changed(focused) => {
                                    root.appearance-contrast-focus-changed(focused);
                                }
                                clicked => { VisualPreferences.high-contrast-requested(!VisualPreferences.high-contrast); }
                            }
                            Text {
                                text: "Scale " + round(VisualPreferences.density-scale * 100) + "%";
                                color: DesignTokens.text-secondary;
                                font-size: Metrics.type-small;
                                accessible-role: text;
                                accessible-live-region: AccessibleLiveness.polite;
                            }
                            SecondaryButton {
                                text: "Smaller";
                                accessible-name: "Decrease interface scale";
                                enabled: VisualPreferences.density-scale > 0.8;
                                clicked => { VisualPreferences.density-scale-requested(VisualPreferences.density-scale - 0.1); }
                            }
                            SecondaryButton {
                                text: "Larger";
                                accessible-name: "Increase interface scale";
                                enabled: VisualPreferences.density-scale < 2.0;
                                clicked => { VisualPreferences.density-scale-requested(VisualPreferences.density-scale + 0.1); }
                            }
                            Text {
                                text: "Reduced motion: " + (VisualPreferences.reduced-motion ? "On" : "Off");
                                color: DesignTokens.text-secondary;
                                font-size: Metrics.type-small;
                                accessible-role: text;
                            }
                            SecondaryButton {
                                text: "Motion";
                                focus-id: "settings.appearance.motion";
                                accessible-name: VisualPreferences.reduced-motion ? "Enable motion" : "Reduce motion";
                                checkable: true;
                                checked: VisualPreferences.reduced-motion;
                                clicked => { VisualPreferences.reduced-motion-requested(!VisualPreferences.reduced-motion); }
                            }
                        }
                        Text { text: "The native Fluent or Cupertino style follows the operating system build."; color: DesignTokens.text-muted; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: text; }
                    }

                    if (root.selected-section == 4) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: "Notifications unavailable"; color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        Text { text: "No notification service is connected to this preview."; color: DesignTokens.text-secondary; font-size: Metrics.type-small; accessible-role: text; }
                    }

                    if (root.selected-section == 5) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: "Keyboard shortcuts"; color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        Text { text: "F1  Command palette\nCtrl+1…7  Preview destinations\nEscape  Close the active dialog\nEnter  Open the selected palette command"; color: DesignTokens.text-secondary; font-size: Metrics.type-small; accessible-role: text; }
                    }

                    if (root.selected-section == 6) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: @tr("In-app updates are not composed"); color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        SemanticBadge { text: @tr("Unavailable"); tone: 2; }
                        Text { text: @tr("This desktop shell does not query a release feed or invoke the native updater. Use your deployment channel to check for a signed release."); color: DesignTokens.text-secondary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                        PrimaryButton { text: @tr("View update guidance"); clicked => { root.update-requested(); } }
                    }

                    if (root.selected-section == 7) : VerticalLayout {
                        spacing: Metrics.space-3;
                        Text { text: @tr("Diagnostic availability"); color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                        Text { text: @tr("The live Gateway connection summary is available. Renderer, accessibility, policy, storage, and worker diagnostics are not wired."); color: DesignTokens.text-secondary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                        PrimaryButton { text: @tr("View diagnostic availability"); clicked => { root.diagnostics-requested(); } }
                    }
                }
            }
        }
    }
}

component DiffViewer {
    in property <[DiffItem]> lines;
    in property <int> mode;
    in property <string> file-name: "Selected file";
    callback mode-requested(int);

    accessible-role: region;
    accessible-label: root.mode == 0 ? "Unified diff viewer" : "Side by side diff viewer";

    VerticalLayout {
        spacing: Metrics.space-2;

        HorizontalLayout {
            spacing: Metrics.space-2;
            Text {
                text: root.file-name;
                color: DesignTokens.text-primary;
                font-size: Metrics.type-small;
                font-weight: 750;
                vertical-alignment: center;
                accessible-role: text;
            }
            Rectangle { horizontal-stretch: 1; }
            SecondaryButton {
                text: "Unified";
                accessible-name: "Unified diff view";
                checkable: true;
                checked: root.mode == 0;
                clicked => { root.mode-requested(0); }
            }
            SecondaryButton {
                text: "Side by side";
                accessible-name: "Side by side diff view";
                checkable: true;
                checked: root.mode == 1;
                clicked => { root.mode-requested(1); }
            }
        }

        ListView {
            accessible-label: root.file-name + " diff";
            accessible-item-count: root.lines.length;

            for line[index] in root.lines : Rectangle {
                height: max(28px, Metrics.line-caption + 2 * Metrics.space-1);
                background: line.kind == 1
                    ? DesignTokens.success-surface
                    : (line.kind == 2 ? DesignTokens.danger-surface : DesignTokens.surface-raised);
                accessible-role: list-item;
                accessible-item-index: index;
                accessible-item-count: root.lines.length;
                accessible-label: (line.kind == 1 ? "added" : (line.kind == 2 ? "removed" : "unchanged"))
                    + ", " + (root.mode == 0
                        ? "line " + line.new-line + ", " + line.text
                        : "old line " + line.old-line + ", " + line.old-text
                            + ", new line " + line.new-line + ", " + line.new-text);

                if (root.mode == 0) : HorizontalLayout {
                    spacing: Metrics.space-2;
                    Text { width: 34px; text: line.old-line; color: DesignTokens.text-muted; font-size: Metrics.type-caption; horizontal-alignment: right; accessible-role: none; }
                    Text { width: 34px; text: line.new-line; color: DesignTokens.text-muted; font-size: Metrics.type-caption; horizontal-alignment: right; accessible-role: none; }
                    Text { text: line.text; color: DesignTokens.text-primary; font-size: Metrics.type-caption; overflow: elide; accessible-role: none; }
                }

                if (root.mode == 1) : HorizontalLayout {
                    spacing: Metrics.space-2;
                    Text { width: 30px; text: line.old-line; color: DesignTokens.text-muted; font-size: Metrics.type-caption; horizontal-alignment: right; accessible-role: none; }
                    Text { horizontal-stretch: 1; text: line.old-text; color: DesignTokens.text-primary; font-size: Metrics.type-caption; overflow: elide; accessible-role: none; }
                    Divider { vertical: true; }
                    Text { width: 30px; text: line.new-line; color: DesignTokens.text-muted; font-size: Metrics.type-caption; horizontal-alignment: right; accessible-role: none; }
                    Text { horizontal-stretch: 1; text: line.new-text; color: DesignTokens.text-primary; font-size: Metrics.type-caption; overflow: elide; accessible-role: none; }
                }
            }
        }
    }
}

component ApprovalPrompt {
    in property <string> prompt;
    in property <string> scope;
    in property <bool> interactions-enabled;
    in property <bool> narrow;
    out property <bool> stacked: root.narrow
        || VisualPreferences.density-scale > 1.25
        || root.width < 680px;
    out property <bool> text-bounds-fit:
        root.width > 0px
        && root.height > 0px
        && approval-layout.width > 0px
        && approval-layout.height > 0px
        && prompt-copy.width > 0px
        && prompt-copy.height > 0px
        && title-text.width > 0px
        && title-text.height > 0px
        && title-text.preferred-height > 0px
        && title-text.height >= title-text.preferred-height
        && prompt-text.width > 0px
        && prompt-text.height > 0px
        && prompt-text.preferred-height > 0px
        && prompt-text.height >= prompt-text.preferred-height
        && scope-text.width > 0px
        && scope-text.height > 0px
        && scope-text.preferred-height > 0px
        && scope-text.height >= scope-text.preferred-height
        && title-text.absolute-position.x >= prompt-copy.absolute-position.x
        && prompt-text.absolute-position.x >= prompt-copy.absolute-position.x
        && scope-text.absolute-position.x >= prompt-copy.absolute-position.x
        && title-text.absolute-position.y >= prompt-copy.absolute-position.y
        && prompt-text.absolute-position.y >= prompt-copy.absolute-position.y
        && scope-text.absolute-position.y >= prompt-copy.absolute-position.y
        && title-text.absolute-position.x + title-text.width
            <= prompt-copy.absolute-position.x + prompt-copy.width + 1px
        && prompt-text.absolute-position.x + prompt-text.width
            <= prompt-copy.absolute-position.x + prompt-copy.width + 1px
        && scope-text.absolute-position.x + scope-text.width
            <= prompt-copy.absolute-position.x + prompt-copy.width + 1px
        && title-text.absolute-position.y + title-text.height
            <= prompt-copy.absolute-position.y + prompt-copy.height + 1px
        && prompt-text.absolute-position.y + prompt-text.height
            <= prompt-copy.absolute-position.y + prompt-copy.height + 1px
        && scope-text.absolute-position.y + scope-text.height
            <= prompt-copy.absolute-position.y + prompt-copy.height + 1px;
    out property <bool> controls-bounds-fit:
        deny-button.width > 0px
        && deny-button.height > 0px
        && approve-button.width > 0px
        && approve-button.height > 0px
        && deny-button.absolute-position.x >= approval-layout.absolute-position.x
        && approve-button.absolute-position.x >= approval-layout.absolute-position.x
        && deny-button.absolute-position.y >= approval-layout.absolute-position.y
        && approve-button.absolute-position.y >= approval-layout.absolute-position.y
        && deny-button.content-bounds-fit
        && approve-button.content-bounds-fit
        && deny-button.absolute-position.x + deny-button.width
            <= root.absolute-position.x + root.width - Metrics.space-4 + 1px
        && approve-button.absolute-position.x + approve-button.width
            <= root.absolute-position.x + root.width - Metrics.space-4 + 1px
        && deny-button.absolute-position.y + deny-button.height
            <= root.absolute-position.y + root.height - Metrics.space-4 + 1px
        && approve-button.absolute-position.y + approve-button.height
            <= root.absolute-position.y + root.height - Metrics.space-4 + 1px;
    out property <bool> controls-no-overlap: root.stacked
        ? prompt-copy.absolute-position.y + prompt-copy.height
                <= deny-button.absolute-position.y + 1px
            && deny-button.absolute-position.y + deny-button.height
                <= approve-button.absolute-position.y + 1px
        : prompt-copy.absolute-position.x + prompt-copy.width
                <= deny-button.absolute-position.x + 1px
            && deny-button.absolute-position.x + deny-button.width
                <= approve-button.absolute-position.x + 1px;
    private property <bool> observed-text-bounds-fit: root.text-bounds-fit;
    private property <bool> observed-controls-bounds-fit: root.controls-bounds-fit;
    private property <bool> observed-controls-no-overlap: root.controls-no-overlap;
    private property <bool> observed-stacked: root.stacked;
    callback decision(bool);
    callback geometry-changed(bool, bool, bool, bool);

    min-height: approval-layout.min-height + 2 * Metrics.space-4;
    vertical-stretch: 0;
    accessible-role: region;
    accessible-label: "Sample approval prompt, actions unavailable";

    function report-geometry() {
        root.geometry-changed(
            root.text-bounds-fit,
            root.controls-bounds-fit,
            root.controls-no-overlap,
            root.stacked
        );
    }

    init => { root.report-geometry(); }
    changed observed-text-bounds-fit => { root.report-geometry(); }
    changed observed-controls-bounds-fit => { root.report-geometry(); }
    changed observed-controls-no-overlap => { root.report-geometry(); }
    changed observed-stacked => { root.report-geometry(); }

    Rectangle {
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border-default;
        border-radius: Metrics.radius-large;
    }

    approval-layout := GridLayout {
        x: Metrics.space-4;
        y: Metrics.space-4;
        width: parent.width - 2 * Metrics.space-4;
        spacing: Metrics.space-3;

        prompt-copy := VerticalLayout {
            row: 0;
            col: 0;
            min-width: 0px;
            horizontal-stretch: 1;
            spacing: Metrics.space-1;

            title-text := Text {
                text: "Sample approval prompt";
                color: DesignTokens.warning;
                font-size: Metrics.type-small;
                font-weight: 850;
                wrap: word-wrap;
                accessible-role: text;
            }
            prompt-text := Text {
                text: root.prompt;
                color: DesignTokens.text-primary;
                font-size: Metrics.type-small;
                wrap: word-wrap;
                accessible-role: text;
            }
            scope-text := Text {
                text: root.scope;
                color: DesignTokens.text-muted;
                font-size: Metrics.type-caption;
                wrap: word-wrap;
                accessible-role: text;
            }
        }

        deny-button := DangerButton {
            row: root.stacked ? 1 : 0;
            col: root.stacked ? 0 : 1;
            horizontal-stretch: root.stacked ? 1 : 0;
            text: "Deny unavailable";
            accessible-name: "Deny approval unavailable in read-only preview";
            focus-id: "session.approval.deny";
            enabled: root.interactions-enabled;
            clicked => { root.decision(false); }
        }

        approve-button := PrimaryButton {
            row: root.stacked ? 2 : 0;
            col: root.stacked ? 0 : 2;
            horizontal-stretch: root.stacked ? 1 : 0;
            text: "Approve unavailable";
            accessible-name: "Approve unavailable in read-only preview";
            focus-id: "session.approval.approve";
            enabled: root.interactions-enabled;
            clicked => { root.decision(true); }
        }
    }
}

component QuestionPrompt {
    in property <string> question;
    in property <bool> interactions-enabled;
    in property <bool> narrow;
    out property <bool> stacked: root.narrow
        || VisualPreferences.density-scale > 1.25
        || root.width < 560px;
    out property <bool> text-bounds-fit:
        root.width > 0px
        && root.height > 0px
        && question-layout.width > 0px
        && question-layout.height > 0px
        && question-copy.width > 0px
        && question-copy.height > 0px
        && title-text.width > 0px
        && title-text.height > 0px
        && title-text.preferred-height > 0px
        && title-text.height >= title-text.preferred-height
        && question-text.width > 0px
        && question-text.height > 0px
        && question-text.preferred-height > 0px
        && question-text.height >= question-text.preferred-height
        && title-text.absolute-position.x >= question-copy.absolute-position.x
        && title-text.absolute-position.y >= question-copy.absolute-position.y
        && question-text.absolute-position.x >= question-copy.absolute-position.x
        && question-text.absolute-position.y >= question-copy.absolute-position.y
        && title-text.absolute-position.x + title-text.width
            <= question-copy.absolute-position.x + question-copy.width + 1px
        && question-text.absolute-position.x + question-text.width
            <= question-copy.absolute-position.x + question-copy.width + 1px
        && title-text.absolute-position.y + title-text.height
            <= question-copy.absolute-position.y + question-copy.height + 1px
        && question-text.absolute-position.y + question-text.height
            <= question-copy.absolute-position.y + question-copy.height + 1px;
    out property <bool> controls-bounds-fit:
        continue-button.width > 0px
        && continue-button.height > 0px
        && pause-button.width > 0px
        && pause-button.height > 0px
        && continue-button.content-bounds-fit
        && pause-button.content-bounds-fit
        && continue-button.absolute-position.x >= question-layout.absolute-position.x
        && pause-button.absolute-position.x >= question-layout.absolute-position.x
        && continue-button.absolute-position.y >= question-layout.absolute-position.y
        && pause-button.absolute-position.y >= question-layout.absolute-position.y
        && continue-button.absolute-position.x + continue-button.width
            <= root.absolute-position.x + root.width - Metrics.space-4 + 1px
        && pause-button.absolute-position.x + pause-button.width
            <= root.absolute-position.x + root.width - Metrics.space-4 + 1px
        && continue-button.absolute-position.y + continue-button.height
            <= root.absolute-position.y + root.height - Metrics.space-4 + 1px
        && pause-button.absolute-position.y + pause-button.height
            <= root.absolute-position.y + root.height - Metrics.space-4 + 1px;
    out property <bool> controls-no-overlap: root.stacked
        ? question-copy.absolute-position.y + question-copy.height
                <= continue-button.absolute-position.y + 1px
            && continue-button.absolute-position.y + continue-button.height
                <= pause-button.absolute-position.y + 1px
        : question-copy.absolute-position.x + question-copy.width
                <= continue-button.absolute-position.x + 1px
            && continue-button.absolute-position.x + continue-button.width
                <= pause-button.absolute-position.x + 1px;
    private property <bool> observed-text-bounds-fit: root.text-bounds-fit;
    private property <bool> observed-controls-bounds-fit: root.controls-bounds-fit;
    private property <bool> observed-controls-no-overlap: root.controls-no-overlap;
    private property <bool> observed-stacked: root.stacked;
    callback answered(string);
    callback geometry-changed(bool, bool, bool, bool);

    min-height: question-layout.min-height + 2 * Metrics.space-4;
    vertical-stretch: 0;
    accessible-role: region;
    accessible-label: "Sample agent question, actions unavailable";

    function report-geometry() {
        root.geometry-changed(
            root.text-bounds-fit,
            root.controls-bounds-fit,
            root.controls-no-overlap,
            root.stacked
        );
    }

    init => { root.report-geometry(); }
    changed observed-text-bounds-fit => { root.report-geometry(); }
    changed observed-controls-bounds-fit => { root.report-geometry(); }
    changed observed-controls-no-overlap => { root.report-geometry(); }
    changed observed-stacked => { root.report-geometry(); }

    Rectangle {
        background: DesignTokens.surface-raised;
        border-width: 1px;
        border-color: DesignTokens.border-default;
        border-radius: Metrics.radius-large;
    }

    question-layout := GridLayout {
        x: Metrics.space-4;
        y: Metrics.space-4;
        width: parent.width - 2 * Metrics.space-4;
        spacing: Metrics.space-2;

        question-copy := VerticalLayout {
            row: 0;
            col: 0;
            min-width: 0px;
            horizontal-stretch: 1;
            spacing: Metrics.space-1;

            title-text := Text {
                text: "Sample agent question";
                color: DesignTokens.info;
                font-size: Metrics.type-caption;
                font-weight: 850;
                wrap: word-wrap;
                accessible-role: text;
            }
            question-text := Text {
                text: root.question;
                color: DesignTokens.text-primary;
                font-size: Metrics.type-small;
                wrap: word-wrap;
                accessible-role: text;
            }
        }

        continue-button := PrimaryButton {
            row: root.stacked ? 1 : 0;
            col: root.stacked ? 0 : 1;
            horizontal-stretch: root.stacked ? 1 : 0;
            text: "Continue unavailable";
            accessible-name: "Continue unavailable in read-only preview";
            focus-id: "session.question.continue";
            enabled: root.interactions-enabled;
            clicked => { root.answered("Continue"); }
        }

        pause-button := SecondaryButton {
            row: root.stacked ? 2 : 0;
            col: root.stacked ? 0 : 2;
            horizontal-stretch: root.stacked ? 1 : 0;
            text: "Pause unavailable";
            accessible-name: "Pause unavailable in read-only preview";
            focus-id: "session.question.pause";
            enabled: root.interactions-enabled;
            clicked => { root.answered("Pause run"); }
        }
    }
}

component SessionHeader {
    in property <string> title;
    in property <string> detail;
    in property <string> state;
    in property <int> tone;
    in property <bool> narrow;
    out property <bool> stacked: root.narrow
        || VisualPreferences.density-scale > 1.25
        || root.width < 760px;
    out property <bool> text-bounds-fit:
        root.width > 0px
        && root.height > 0px
        && header-layout.width > 0px
        && header-layout.height > 0px
        && header-copy.width > 0px
        && header-copy.height > 0px
        && title-text.width > 0px
        && title-text.height > 0px
        && title-text.preferred-height > 0px
        && title-text.height >= title-text.preferred-height
        && detail-text.width > 0px
        && detail-text.height > 0px
        && detail-text.preferred-height > 0px
        && detail-text.height >= detail-text.preferred-height
        && title-text.absolute-position.x >= header-copy.absolute-position.x
        && title-text.absolute-position.y >= header-copy.absolute-position.y
        && detail-text.absolute-position.x >= header-copy.absolute-position.x
        && detail-text.absolute-position.y >= header-copy.absolute-position.y
        && title-text.absolute-position.x + title-text.width
            <= header-copy.absolute-position.x + header-copy.width + 1px
        && detail-text.absolute-position.x + detail-text.width
            <= header-copy.absolute-position.x + header-copy.width + 1px
        && title-text.absolute-position.y + title-text.height
            <= header-copy.absolute-position.y + header-copy.height + 1px
        && detail-text.absolute-position.y + detail-text.height
            <= header-copy.absolute-position.y + header-copy.height + 1px;
    out property <bool> back-bounds-fit:
        back-button.width > 0px
        && back-button.height > 0px
        && back-button.content-bounds-fit
        && back-button.absolute-position.x >= header-layout.absolute-position.x
        && back-button.absolute-position.y >= header-layout.absolute-position.y
        && back-button.absolute-position.x + back-button.width
            <= root.absolute-position.x + root.width - Metrics.space-3 + 1px
        && back-button.absolute-position.y + back-button.height
            <= root.absolute-position.y + root.height - Metrics.space-3 + 1px;
    out property <bool> status-bounds-fit:
        state-badge.width > 0px
        && state-badge.height > 0px
        && state-badge.content-bounds-fit
        && state-badge.absolute-position.x >= header-layout.absolute-position.x
        && state-badge.absolute-position.y >= header-layout.absolute-position.y
        && state-badge.absolute-position.x + state-badge.width
            <= root.absolute-position.x + root.width - Metrics.space-3 + 1px
        && state-badge.absolute-position.y + state-badge.height
            <= root.absolute-position.y + root.height - Metrics.space-3 + 1px;
    out property <bool> no-overlap: root.stacked
        ? back-button.absolute-position.y + back-button.height
                <= header-copy.absolute-position.y + 1px
            && header-copy.absolute-position.y + header-copy.height
                <= state-badge.absolute-position.y + 1px
        : back-button.absolute-position.x + back-button.width
                <= header-copy.absolute-position.x + 1px
            && header-copy.absolute-position.x + header-copy.width
                <= state-badge.absolute-position.x + 1px;
    private property <bool> observed-text-bounds-fit: root.text-bounds-fit;
    private property <bool> observed-back-bounds-fit: root.back-bounds-fit;
    private property <bool> observed-status-bounds-fit: root.status-bounds-fit;
    private property <bool> observed-no-overlap: root.no-overlap;
    private property <bool> observed-stacked: root.stacked;
    callback back-requested;
    callback geometry-changed(bool, bool, bool, bool, bool);

    min-height: header-layout.min-height + 2 * Metrics.space-3;
    vertical-stretch: 0;
    accessible-role: banner;
    accessible-label: "Read-only session preview header";

    function report-geometry() {
        root.geometry-changed(
            root.text-bounds-fit,
            root.back-bounds-fit,
            root.status-bounds-fit,
            root.no-overlap,
            root.stacked
        );
    }

    init => { root.report-geometry(); }
    changed observed-text-bounds-fit => { root.report-geometry(); }
    changed observed-back-bounds-fit => { root.report-geometry(); }
    changed observed-status-bounds-fit => { root.report-geometry(); }
    changed observed-no-overlap => { root.report-geometry(); }
    changed observed-stacked => { root.report-geometry(); }

    Rectangle {
        background: DesignTokens.surface-pane;
        border-width: 1px;
        border-color: DesignTokens.border-default;
    }

    header-layout := GridLayout {
        x: Metrics.space-3;
        y: Metrics.space-3;
        width: parent.width - 2 * Metrics.space-3;
        spacing: Metrics.space-3;

        back-button := SecondaryButton {
            row: 0;
            col: 0;
            text: "Back";
            accessible-name: "Back to run previews";
            focus-id: "session.header.back";
            clicked => { root.back-requested(); }
        }

        header-copy := VerticalLayout {
            row: root.stacked ? 1 : 0;
            col: root.stacked ? 0 : 1;
            min-width: 0px;
            horizontal-stretch: 1;
            spacing: Metrics.space-1;

            title-text := Text {
                text: root.title;
                color: DesignTokens.text-primary;
                font-size: Metrics.type-small;
                font-weight: 800;
                wrap: word-wrap;
                accessible-role: text;
            }
            detail-text := Text {
                text: root.detail;
                color: DesignTokens.text-muted;
                font-size: Metrics.type-caption;
                wrap: word-wrap;
                accessible-role: text;
            }
        }

        state-badge := SemanticBadge {
            row: root.stacked ? 2 : 0;
            col: root.stacked ? 0 : 2;
            text: root.state;
            tone: root.tone;
        }
    }
}

component SessionScreen {
    in property <[TranscriptItem]> transcript;
    in property <[ActivityItem]> activity;
    in property <[DiffItem]> diff-lines;
    in property <[FileItem]> files;
    in property <int> selected-file-index: 0;
    in property <string> selected-file-name: "";
    in property <string> session-title: "Session";
    in property <string> session-state: "Draft";
    in property <string> session-detail: "";
    in property <int> session-tone: 0;
    in property <bool> can-approve: false;
    in property <bool> can-answer: false;
    in property <bool> interactions-enabled: false;
    in property <string> approval-prompt: "";
    in property <string> approval-scope: "";
    in property <string> question: "";
    in property <int> diff-mode;
    in property <bool> narrow;

    callback back-requested;
    callback diff-mode-requested(int);
    callback approval-requested(bool);
    callback answer-requested(string);
    callback message-submitted(string);
    callback file-selected(int);
    callback approval-geometry-changed(bool, bool, bool, bool);
    callback question-geometry-changed(bool, bool, bool, bool);
    callback header-geometry-changed(bool, bool, bool, bool, bool);

    accessible-role: main;
    accessible-label: "Read-only session preview";

    // Fixed row height so the virtualized file lists can size themselves.
    private property <length> file-row-height: max(Metrics.control-large,
        2 * Metrics.space-2 + Metrics.line-body + 1px + Metrics.line-caption);

    VerticalLayout {
        spacing: 0px;

        SessionHeader {
            title: root.session-title;
            detail: root.session-detail;
            state: root.session-state;
            tone: root.session-tone;
            narrow: root.narrow;
            back-requested => { root.back-requested(); }
            geometry-changed(
                text-bounds-fit,
                back-bounds-fit,
                status-bounds-fit,
                no-overlap,
                stacked
            ) => {
                root.header-geometry-changed(
                    text-bounds-fit,
                    back-bounds-fit,
                    status-bounds-fit,
                    no-overlap,
                    stacked
                );
            }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            if (!root.narrow) : Rectangle {
                width: 190px;
                horizontal-stretch: 0;
                background: DesignTokens.surface-pane;
                border-width: 1px;
                border-color: DesignTokens.border-default;

                VerticalLayout {
                    padding: Metrics.space-3;
                    spacing: Metrics.space-2;
                    Text { text: "Files"; color: DesignTokens.text-primary; font-size: Metrics.type-small; font-weight: 800; accessible-role: text; }
                    wide-files := ScrollView {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: wide-file-rows.min-height;

                        wide-file-rows := VerticalLayout {
                            width: parent.width;
                            accessible-role: list;
                            accessible-label: "Session files";
                            accessible-item-count: root.files.length;

                            for file[index] in root.files : NavigationItem {
                                height: root.file-row-height;
                                glyph: "F";
                                text: file.name;
                                detail: file.status;
                                selected: root.selected-file-index == index;
                                focus-received => {
                                    let row-y = wide-files.viewport-y + index * root.file-row-height;
                                    if (row-y < 0px) {
                                        wide-files.viewport-y -= row-y;
                                    } else if (row-y + root.file-row-height > wide-files.visible-height) {
                                        wide-files.viewport-y -= row-y + root.file-row-height - wide-files.visible-height;
                                    }
                                }
                                clicked => { root.file-selected(index); }
                            }
                        }
                    }
                    Card {
                        accessible-name: "Pinned artifact preview";
                        Text { text: "Artifact"; color: DesignTokens.text-muted; font-size: Metrics.type-caption; font-weight: 700; accessible-role: none; }
                        Text { text: "UI walkthrough"; color: DesignTokens.text-primary; font-size: Metrics.type-small; font-weight: 750; accessible-role: text; }
                        Text { text: "Markdown · pinned"; color: DesignTokens.text-muted; font-size: Metrics.type-caption; accessible-role: text; }
                    }
                }
            }

            ScrollView {
                horizontal-stretch: 1;
                viewport-width: self.width;
                viewport-height: center-body.min-height;

                center-body := VerticalLayout {
                    width: parent.width;
                    spacing: Metrics.space-2;
                    padding: Metrics.space-3;

                    if (root.narrow) : Card {
                        accessible-name: "Session files";
                        Text { text: "Files"; color: DesignTokens.text-primary; font-size: Metrics.type-small; font-weight: 800; accessible-role: text; }
                        narrow-files := ScrollView {
                            height: min(5 * root.file-row-height, max(root.file-row-height, root.files.length * root.file-row-height));
                            vertical-stretch: 0;
                            viewport-width: self.width;
                            viewport-height: narrow-file-rows.min-height;

                            narrow-file-rows := VerticalLayout {
                                width: parent.width;
                                accessible-role: list;
                                accessible-label: "Session files";
                                accessible-item-count: root.files.length;

                                for file[index] in root.files : NavigationItem {
                                    height: root.file-row-height;
                                    glyph: "F";
                                    text: file.name;
                                    detail: file.status;
                                    selected: root.selected-file-index == index;
                                    focus-received => {
                                        let row-y = narrow-files.viewport-y + index * root.file-row-height;
                                        if (row-y < 0px) {
                                            narrow-files.viewport-y -= row-y;
                                        } else if (row-y + root.file-row-height > narrow-files.visible-height) {
                                            narrow-files.viewport-y -= row-y + root.file-row-height - narrow-files.visible-height;
                                        }
                                    }
                                    clicked => { root.file-selected(index); }
                                }
                            }
                        }
                    }

                    ListView {
                    height: 300px;
                    vertical-stretch: 0;
                    accessible-label: "Streaming transcript";
                    accessible-item-count: root.transcript.length;

                    for entry[index] in root.transcript : Rectangle {
                        height: max(86px, 3 * Metrics.line-body + 2 * Metrics.space-2);
                        accessible-role: list-item;
                        accessible-item-index: index;
                        accessible-item-count: root.transcript.length;
                        accessible-label: entry.role + " at " + entry.timestamp + ". " + entry.text + " " + entry.detail;
                        background: entry.tone == 2
                            ? DesignTokens.warning-surface
                            : (entry.tone == 1 ? DesignTokens.info-surface : DesignTokens.surface-raised);
                        border-width: 1px;
                        border-color: DesignTokens.border-default;
                        border-radius: Metrics.radius-medium;

                        VerticalLayout {
                            padding: Metrics.space-2;
                            spacing: Metrics.space-1;
                            HorizontalLayout {
                                Text { text: entry.role; color: DesignTokens.text-primary; font-size: Metrics.type-caption; font-weight: 800; accessible-role: none; }
                                Rectangle { horizontal-stretch: 1; }
                                Text { text: entry.timestamp; color: DesignTokens.text-muted; font-size: Metrics.type-caption; accessible-role: none; }
                            }
                            Text { text: entry.text; color: DesignTokens.text-primary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                            Text { text: entry.detail; color: DesignTokens.text-muted; font-size: Metrics.type-caption; overflow: elide; accessible-role: text; }
                        }
                    }
                }

                if (root.can-approve) : ApprovalPrompt {
                    prompt: root.approval-prompt;
                    scope: root.approval-scope;
                    interactions-enabled: root.interactions-enabled;
                    narrow: root.narrow;
                    decision(approved) => { root.approval-requested(approved); }
                    geometry-changed(
                        text-bounds-fit,
                        controls-bounds-fit,
                        controls-no-overlap,
                        stacked
                    ) => {
                        root.approval-geometry-changed(
                            text-bounds-fit,
                            controls-bounds-fit,
                            controls-no-overlap,
                            stacked
                        );
                    }
                }

                if (root.can-answer) : QuestionPrompt {
                    question: root.question;
                    interactions-enabled: root.interactions-enabled;
                    narrow: root.narrow;
                    answered(answer) => { root.answer-requested(answer); }
                    geometry-changed(
                        text-bounds-fit,
                        controls-bounds-fit,
                        controls-no-overlap,
                        stacked
                    ) => {
                        root.question-geometry-changed(
                            text-bounds-fit,
                            controls-bounds-fit,
                            controls-no-overlap,
                            stacked
                        );
                    }
                }

                ComposerShell {
                    accessible-name: "Messaging unavailable in read-only preview";
                    placeholder: "Messaging unavailable in preview";
                    submit-label: "Unavailable";
                    enabled: root.interactions-enabled;
                    submitted(message) => { root.message-submitted(message); }
                }

                Rectangle {
                    height: 260px;
                    vertical-stretch: 0;
                    background: DesignTokens.surface-pane;
                    border-width: 1px;
                    border-color: DesignTokens.border-default;
                    border-radius: Metrics.radius-large;

                    DiffViewer {
                        x: Metrics.space-3;
                        y: Metrics.space-3;
                        width: parent.width - 2 * Metrics.space-3;
                        height: parent.height - 2 * Metrics.space-3;
                        lines: root.diff-lines;
                        mode: root.diff-mode;
                        file-name: root.selected-file-name;
                        mode-requested(mode) => { root.diff-mode-requested(mode); }
                    }
                }
                }
            }

            if (!root.narrow) : Rectangle {
                width: 260px;
                horizontal-stretch: 0;
                background: DesignTokens.surface-pane;
                border-width: 1px;
                border-color: DesignTokens.border-default;

                VerticalLayout {
                    padding: Metrics.space-3;
                    spacing: Metrics.space-3;

                    Text { text: "Activity"; color: DesignTokens.text-primary; font-size: Metrics.type-small; font-weight: 850; accessible-role: text; }

                    ListView {
                        vertical-stretch: 1;
                        accessible-label: "Tool activity timeline";
                        accessible-item-count: root.activity.length;

                        for item[index] in root.activity : Rectangle {
                            height: max(92px, 3 * Metrics.line-caption + Metrics.control-small + 2 * Metrics.space-2);
                            accessible-role: list-item;
                            accessible-item-index: index;
                            accessible-item-count: root.activity.length;
                            accessible-label: item.title + ", " + item.state + ", " + item.detail + ", " + item.duration;
                            background: DesignTokens.surface-raised;
                            border-width: 1px;
                            border-color: DesignTokens.border-default;
                            border-radius: Metrics.radius-medium;

                            VerticalLayout {
                                padding: Metrics.space-2;
                                spacing: Metrics.space-1;
                                Text { text: item.title; color: DesignTokens.text-primary; font-size: Metrics.type-caption; font-weight: 800; accessible-role: none; }
                                Text { text: item.detail; color: DesignTokens.text-muted; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: none; }
                                HorizontalLayout {
                                    SemanticBadge { text: item.state; tone: item.tone; }
                                    Rectangle { horizontal-stretch: 1; }
                                    Text { text: item.duration; color: DesignTokens.text-muted; font-size: Metrics.type-caption; accessible-role: none; }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component UpdateScreen {
    callback back-requested;

    accessible-role: main;
    accessible-label: "Application update";

    ScrollView {
        viewport-width: self.width;
        viewport-height: body.min-height;

        body := VerticalLayout {
            width: parent.width;
            padding: Metrics.space-8;
            spacing: Metrics.space-4;

            SectionTitle {
                eyebrow: @tr("UPDATE");
                title: @tr("In-app updates are not available");
                detail: @tr("No release feed or updater adapter is connected to this desktop shell.");
            }
            Card {
                accessible-name: @tr("Update availability");
                SemanticBadge { text: @tr("Not composed"); tone: 2; }
                Text { text: @tr("What you can do"); color: DesignTokens.text-primary; font-size: Metrics.type-title; font-weight: 800; accessible-role: text; }
                Text { text: @tr("Check the release source or package channel used to install GTA Claw. Verify the signed artifact there before replacing this build."); color: DesignTokens.text-secondary; font-size: Metrics.type-small; wrap: word-wrap; accessible-role: text; }
                Divider { }
                Text { text: @tr("No update was downloaded, verified, staged, or installed by this screen."); color: DesignTokens.text-muted; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: text; }
                HorizontalLayout {
                    alignment: end;
                    SecondaryButton { text: @tr("Back"); clicked => { root.back-requested(); } }
                }
            }
        }
    }
}

component DiagnosticsScreen {
    in property <string> gateway-status-text;
    in property <string> gateway-status-label;
    in property <string> gateway-status-icon;
    in property <StatusKind> gateway-status-kind;
    in property <string> gateway-server;
    in property <string> gateway-health;
    callback back-requested;

    accessible-role: main;
    accessible-label: "Diagnostics";

    ScrollView {
        viewport-width: self.width;
        viewport-height: body.min-height;

        body := VerticalLayout {
            width: parent.width;
            padding: Metrics.space-8;
            spacing: Metrics.space-4;

            SectionTitle {
                eyebrow: @tr("DIAGNOSTICS");
                title: @tr("Diagnostic coverage");
                detail: @tr("Only the live Gateway connection summary is wired. Other desktop checks are not composed.");
            }

            Card {
                accessible-name: @tr("Diagnostic availability");
                HorizontalLayout {
                    Text { text: @tr("Gateway connection"); color: DesignTokens.text-primary; font-size: Metrics.type-small; accessible-role: text; }
                    Rectangle { horizontal-stretch: 1; }
                    StatusBadge {
                        text: root.gateway-status-text;
                        semantic-label: root.gateway-status-label;
                        icon-text: root.gateway-status-icon;
                        kind: root.gateway-status-kind;
                    }
                }
                Text { text: @tr("Server: {} · Health probe: {}", root.gateway-server, root.gateway-health); color: DesignTokens.text-secondary; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: text; }
                HorizontalLayout { Text { text: @tr("Renderer report"); color: DesignTokens.text-primary; font-size: Metrics.type-small; accessible-role: text; } Rectangle { horizontal-stretch: 1; } SemanticBadge { text: @tr("Not wired"); tone: 0; } }
                HorizontalLayout { Text { text: @tr("Accessibility inspection"); color: DesignTokens.text-primary; font-size: Metrics.type-small; accessible-role: text; } Rectangle { horizontal-stretch: 1; } SemanticBadge { text: @tr("Use OS inspector"); tone: 1; } }
                HorizontalLayout { Text { text: @tr("Policy and storage checks"); color: DesignTokens.text-primary; font-size: Metrics.type-small; accessible-role: text; } Rectangle { horizontal-stretch: 1; } SemanticBadge { text: @tr("Not wired"); tone: 0; } }
                HorizontalLayout { Text { text: @tr("Worker runtime report"); color: DesignTokens.text-primary; font-size: Metrics.type-small; accessible-role: text; } Rectangle { horizontal-stretch: 1; } SemanticBadge { text: @tr("Not wired"); tone: 0; } }
                Text { text: @tr("For renderer and accessibility details, use the platform diagnostics and accessibility tools for the running application bundle."); color: DesignTokens.text-muted; font-size: Metrics.type-caption; wrap: word-wrap; accessible-role: text; }
                Divider { }
                HorizontalLayout {
                    alignment: end;
                    SecondaryButton { text: @tr("Back"); clicked => { root.back-requested(); } }
                }
            }
        }
    }
}

component PaletteCommandItem inherits NavigationItem {
    in property <int> item-index;
    in property <int> item-count;
    in property <bool> focus-when-selected;

    changed selected => {
        if (root.selected && root.focus-when-selected) {
            root.focus();
        }
    }

    accessible-role: list-item;
    accessible-label: root.text;
    accessible-description: root.detail;
    accessible-item-index: root.item-index;
    accessible-item-count: root.item-count;
}

component CommandPalette inherits FocusScope {
    in-out property <string> query;
    in property <[CommandItem]> commands;
    in property <int> selected-index;
    in property <int> command-count;
    in property <int> selected-action-id: -1;
    in property <string> selected-label;
    in-out property <int> focused-command-index: -1;
    callback dismiss-requested;
    callback query-changed(string);
    callback selection-step-requested(int);
    callback selection-index-requested(int);
    callback command-requested(int);

    private property <length> command-row-height: max(
        Metrics.control-large,
        Metrics.line-body + Metrics.line-caption + 2 * Metrics.space-2
    );
    private property <length> command-row-stride: root.command-row-height + Metrics.space-1;
    private property <bool> compact-content: root.height < 640px
        || VisualPreferences.density-scale > 1.25;

    min-width: 0px;
    min-height: 0px;
    max-width: 100000px;
    max-height: 100000px;

    function reveal-command(index: int) {
        if (commands-scroll.visible-height <= 0px) {
            return;
        }
        let selected-top = index * root.command-row-stride;
        let selected-bottom = selected-top + root.command-row-height;
        let visible-top = -commands-scroll.viewport-y;
        let visible-bottom = visible-top + commands-scroll.visible-height;
        if (selected-top < visible-top) {
            commands-scroll.viewport-y = -selected-top;
        } else if (selected-bottom > visible-bottom) {
            commands-scroll.viewport-y = -(selected-bottom - commands-scroll.visible-height);
        }
    }

    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            root.selection-step-requested(-1);
            return accept;
        }
        if (event.text == Key.DownArrow) {
            root.selection-step-requested(1);
            return accept;
        }
        return reject;
    }

    changed query => {
        commands-scroll.viewport-y = 0px;
        root.focused-command-index = -1;
    }

    changed selected-index => {
        root.reveal-command(root.selected-index);
    }

    Rectangle {
        width: 100%;
        height: 100%;
        background: #00000066;
        TouchArea {
            clicked => { root.dismiss-requested(); }
            scroll-event(event) => { return accept; }
        }

        ModalSheetShell {
            x: max(0px, (parent.width - self.width) / 2);
            y: max(0px, min(Metrics.space-8, (parent.height - self.height) / 2));
            width: max(0px, min(680px, parent.width - 2 * Metrics.space-3));
            height: max(0px, min(560px, parent.height - 2 * Metrics.space-3));
            title: @tr("Command palette");
            dismiss-label: @tr("Close palette");
            focus-close-on-init: false;
            compact-content: root.compact-content;
            dismiss-requested => { root.dismiss-requested(); }

            VerticalLayout {
                accessible-role: search;
                accessible-label: @tr("Command search");

                palette-search := TextField {
                    label: root.compact-content ? "" : @tr("Search commands");
                    accessible-name: @tr("Search commands");
                    placeholder: @tr("Type a destination or task");
                    text <=> root.query;
                    focus-on-init: true;
                    intercept-vertical-navigation: true;
                    focus-changed(focused) => {
                        if (focused) {
                            root.focused-command-index = -1;
                        }
                    }
                    edited(value) => { root.query-changed(value); }
                    vertical-navigation-requested(step) => {
                        root.selection-step-requested(step);
                    }
                    accepted => {
                        if (root.selected-action-id >= 0) {
                            root.command-requested(root.selected-action-id);
                        }
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                min-height: root.compact-content ? Metrics.control-large : 120px;

                commands-scroll := ScrollView {
                    visible: root.command-count > 0;
                    viewport-width: self.width;
                    viewport-height: commands-layout.min-height;

                    commands-layout := VerticalLayout {
                        width: parent.width;
                        spacing: Metrics.space-1;
                        accessible-role: list;
                        accessible-label: @tr("Matching commands");
                        accessible-item-count: root.command-count;

                        for command[index] in root.commands : PaletteCommandItem {
                            height: root.command-row-height;
                            glyph: command.glyph;
                            text: command.title;
                            detail: command.detail;
                            selected: index == root.selected-index;
                            focus-when-selected: root.focused-command-index >= 0;
                            item-index: index;
                            item-count: root.command-count;
                            focus-received => {
                                root.focused-command-index = index;
                                root.selection-index-requested(index);
                                root.reveal-command(index);
                            }
                            clicked => {
                                root.selection-index-requested(index);
                                root.command-requested(command.action-id);
                            }
                        }
                    }
                }

                if (root.command-count == 0) : Rectangle {
                    background: DesignTokens.surface-subtle;
                    border-width: 1px;
                    border-color: DesignTokens.border-default;
                    border-radius: Metrics.radius-medium;
                    accessible-role: region;
                    accessible-label: @tr("No commands match '{}'", root.query);

                    VerticalLayout {
                        alignment: center;
                        spacing: Metrics.space-2;

                        Text {
                            text: @tr("No matching commands");
                            color: DesignTokens.text-primary;
                            font-size: Metrics.type-small;
                            font-weight: 700;
                            horizontal-alignment: center;
                            accessible-role: none;
                        }
                        Text {
                            text: @tr("Try a destination, task, or setting.");
                            color: DesignTokens.text-muted;
                            font-size: Metrics.type-caption;
                            horizontal-alignment: center;
                            accessible-role: none;
                        }
                    }
                }
            }

            VerticalLayout {
                spacing: Metrics.space-1;

                Text {
                    text: root.command-count == 0
                        ? @tr("No commands available")
                        : @tr("Selected: {}", root.selected-label);
                    color: DesignTokens.text-secondary;
                    font-size: Metrics.type-caption;
                    wrap: word-wrap;
                    accessible-role: text;
                    accessible-live-region: polite;
                }
                if (!root.compact-content) : Text {
                    text: @tr("Use Up/Down to choose, Enter to open, and Escape to close.");
                    color: DesignTokens.text-muted;
                    font-size: Metrics.type-caption;
                    wrap: word-wrap;
                    accessible-role: text;
                }
            }
        }
    }
}

component PrimaryNavigation {
    in property <int> selected-screen;
    in property <bool> compact;
    in property <string> gateway-status-text;
    in property <string> gateway-status-label;
    in property <string> gateway-status-icon;
    in property <StatusKind> gateway-status-kind;
    callback navigate-requested(int);

    function reveal-navigation-item(item-y: length, item-height: length) {
        let view-top = navigation-scroll.absolute-position.y;
        let view-bottom = view-top + navigation-scroll.visible-height;
        if (item-y < view-top) {
            navigation-scroll.viewport-y += view-top - item-y;
        } else if (item-y + item-height > view-bottom) {
            navigation-scroll.viewport-y -= item-y + item-height - view-bottom;
        }
    }

    min-width: 0px;
    preferred-width: 0px;
    max-width: 100000px;
    min-height: 0px;
    preferred-height: 0px;
    max-height: 100000px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    accessible-role: navigation;
    accessible-label: "Primary navigation";

    Rectangle {
        background: DesignTokens.surface-pane;
        border-width: 1px;
        border-color: DesignTokens.border-default;

        navigation-scroll := ScrollView {
            viewport-width: self.width;
            viewport-height: navigation-content.min-height;

            navigation-content := VerticalLayout {
                width: parent.width;
                padding: Metrics.space-3;
                spacing: Metrics.space-1;

                HorizontalLayout {
                    spacing: Metrics.space-2;
                    alignment: center;

                    Rectangle {
                        width: Metrics.control-large;
                        height: Metrics.control-large;
                        horizontal-stretch: 0;
                        background: DesignTokens.accent;
                        border-radius: Metrics.radius-large;
                        Text { text: "GC"; color: DesignTokens.accent-on; font-size: Metrics.type-small; font-weight: 850; horizontal-alignment: center; vertical-alignment: center; accessible-role: none; }
                    }
                    if (!root.compact) : VerticalLayout {
                        spacing: 0px;
                        Text { text: "GTA Claw"; color: DesignTokens.text-primary; font-size: Metrics.type-small; font-weight: 850; accessible-role: none; }
                        Text { text: "Read-only preview"; color: DesignTokens.text-muted; font-size: Metrics.type-caption; accessible-role: none; }
                    }
                }

                Divider { }
                NavigationItem { glyph: "F"; text: root.compact ? "" : "Focus"; detail: root.compact ? "" : "Sample overview"; accessible-name: "Preview focus overview"; selected: root.selected-screen == 0; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.navigate-requested(0); } }
                NavigationItem { glyph: "W"; text: root.compact ? "" : "Workspaces"; detail: root.compact ? "" : "Sample rows"; accessible-name: "Workspace previews"; selected: root.selected-screen == 1; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.navigate-requested(1); } }
                NavigationItem { glyph: "R"; text: root.compact ? "" : "Runs"; detail: root.compact ? "" : "Sample lifecycle"; accessible-name: "Run lifecycle previews"; selected: root.selected-screen == 2 || root.selected-screen == 7; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.navigate-requested(2); } }
                NavigationItem { glyph: "S"; text: root.compact ? "" : "Schedules"; detail: root.compact ? "" : "Unavailable actions"; accessible-name: "Schedule previews, actions unavailable"; selected: root.selected-screen == 3; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.navigate-requested(3); } }
                NavigationItem { glyph: "D"; text: root.compact ? "" : "Deliverables"; detail: root.compact ? "" : "Sample artifacts"; accessible-name: "Artifact previews"; selected: root.selected-screen == 4; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.navigate-requested(4); } }
                NavigationItem { glyph: "E"; text: root.compact ? "" : "Extensions"; detail: root.compact ? "" : "Sample roles and tools"; accessible-name: "Extension previews"; selected: root.selected-screen == 5; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.navigate-requested(5); } }
                Divider { }
                NavigationItem { glyph: "G"; text: root.compact ? "" : "Settings"; detail: root.compact ? "" : "Preferences"; accessible-name: "Settings, preferences"; selected: root.selected-screen == 6 || root.selected-screen == 8 || root.selected-screen == 9; focus-received => { root.reveal-navigation-item(self.absolute-position.y, self.height); } clicked => { root.navigate-requested(6); } }
                StatusBadge {
                    text: root.compact ? "" : root.gateway-status-text;
                    semantic-label: root.gateway-status-label;
                    icon-text: root.gateway-status-icon;
                    accessible-name: @tr("{}: {}", root.gateway-status-label, root.gateway-status-text);
                    kind: root.gateway-status-kind;
                }
            }
        }
    }
}

export component ProductShell inherits FocusScope {
    in property <length> available-width;
    in property <int> selected-screen: 0;
    in property <int> selected-settings-section: 0;
    in property <bool> palette-open: false;
    in-out property <string> palette-query;
    in property <[CommandItem]> palette-commands;
    in property <int> palette-selected-index: 0;
    in property <int> palette-command-count: 0;
    in property <int> palette-selected-action-id: -1;
    in property <string> palette-selected-label;
    in-out property <int> palette-focused-command-index: -1;
    in property <int> diff-mode: 0;
    in property <[RunItem]> runs;
    in property <[WorkspaceItem]> workspaces;
    in property <[ScheduleItem]> schedules;
    in property <[DeliverableItem]> deliverables;
    in property <[ExtensionItem]> extensions;
    in property <[TranscriptItem]> transcript;
    in property <[ActivityItem]> activity;
    in property <[DiffItem]> diff-lines;
    in property <[FileItem]> session-files;
    in property <int> selected-file-index: 0;
    in property <string> selected-file-name: "";
    in property <string> session-title: "Session";
    in property <string> session-state: "Draft";
    in property <string> session-detail: "";
    in property <int> session-tone: 0;
    in property <bool> can-approve: false;
    in property <bool> can-answer: false;
    in property <bool> product-interactions-enabled: false;
    in property <bool> session-narrow-layout: false;
    in property <string> approval-prompt: "";
    in property <string> approval-scope: "";
    in property <string> question: "";
    in property <int> selected-deliverable-index: 0;
    in property <string> selected-deliverable-name: "";
    in property <string> selected-deliverable-kind: "";
    in property <string> selected-deliverable-source: "";
    in property <string> selected-deliverable-size: "";
    in property <string> selected-deliverable-content: "";
    in property <bool> selected-deliverable-pinned: false;
    in property <string> run-page-label: "Page 1 of 1";
    in property <bool> can-previous-run-page: false;
    in property <bool> can-next-run-page: false;
    in property <int> dashboard-awaiting-review: 0;
    in property <int> dashboard-running: 0;
    in property <int> dashboard-blocked: 0;
    in property <int> dashboard-workspaces: 0;
    in-out property <int> focused-run-index: -1;
    in property <string> gateway-status-text;
    in property <string> gateway-status-label;
    in property <string> gateway-status-icon;
    in property <StatusKind> gateway-status-kind;
    in property <string> gateway-server;
    in property <string> gateway-role;
    in property <string> gateway-scopes;
    in property <string> gateway-health;
    out property <bool> compact-navigation: root.available-width < 900px
        || VisualPreferences.density-scale > 1.25;
    private property <length> application-title-min-width:
        max(120px, 2 * Metrics.control-large);
    out property <bool> application-header-title-bounds-fit:
        application-header.width > 0px
        && application-header.height > 0px
        && application-title.width > 0px
        && application-title.height > 0px
        && application-title.width >= root.application-title-min-width
        && application-title.preferred-width > 0px
        && application-title.absolute-position.x >= application-header.absolute-position.x
        && application-title.absolute-position.y >= application-header.absolute-position.y
        && application-title.absolute-position.x + application-title.width
            <= application-header.absolute-position.x + application-header.width + 1px
        && application-title.absolute-position.y + application-title.height
            <= application-header.absolute-position.y + application-header.height + 1px;
    out property <bool> application-header-badge-bounds-fit:
        application-badge.width > 0px
        && application-badge.height > 0px
        && application-badge.content-bounds-fit
        && application-badge.absolute-position.x >= application-header.absolute-position.x
        && application-badge.absolute-position.y >= application-header.absolute-position.y
        && application-badge.absolute-position.x + application-badge.width
            <= application-header.absolute-position.x + application-header.width + 1px
        && application-badge.absolute-position.y + application-badge.height
            <= application-header.absolute-position.y + application-header.height + 1px;
    out property <bool> viewport-bounds-fit:
        root.width > 0px
        && root.height > 0px
        && product-content.width > 0px
        && product-content.height > 0px
        && product-content.absolute-position.x >= root.absolute-position.x
        && product-content.absolute-position.y >= root.absolute-position.y
        && product-content.absolute-position.x + product-content.width
            <= root.absolute-position.x + root.width + 1px
        && product-content.absolute-position.y + product-content.height
            <= root.absolute-position.y + root.height + 1px;
    private property <bool> observed-application-header-title-bounds-fit:
        root.application-header-title-bounds-fit;
    private property <bool> observed-application-header-badge-bounds-fit:
        root.application-header-badge-bounds-fit;
    private property <bool> observed-viewport-bounds-fit: root.viewport-bounds-fit;

    callback navigate-requested(int);
    callback palette-toggle-requested;
    callback palette-dismiss-requested;
    callback palette-query-changed(string);
    callback palette-selection-step-requested(int);
    callback palette-selection-index-requested(int);
    callback palette-command-requested(int);
    callback palette-trigger-focus-changed(bool);
    callback preview-dismiss-trigger-focus-changed(bool);
    callback appearance-contrast-focus-changed(bool);
    callback workspace-card-geometry-changed(int, bool, bool, bool, bool, bool, bool);
    callback schedule-card-geometry-changed(int, bool, bool, bool, bool, bool, bool);
    callback extension-card-geometry-changed(int, bool, bool, bool, bool, bool, bool);
    callback application-header-geometry-changed(bool, bool);
    callback settings-rail-geometry-changed(bool);
    callback viewport-geometry-changed(bool);
    callback run-focus-visibility-changed(bool);
    callback background-scroll-position-changed(length);
    callback preview-dismiss-requested;
    callback open-session-requested(int);
    callback open-workspace-requested(int);
    callback settings-section-requested(int);
    callback disconnect-requested;
    callback update-requested;
    callback diagnostics-requested;
    callback back-requested;
    callback diff-mode-requested(int);
    callback previous-run-page-requested;
    callback next-run-page-requested;
    callback approval-requested(bool);
    callback approval-geometry-changed(bool, bool, bool, bool);
    callback question-geometry-changed(bool, bool, bool, bool);
    callback session-header-geometry-changed(bool, bool, bool, bool, bool);
    callback answer-requested(string);
    callback message-submitted(string);
    callback file-selected(int);
    callback schedule-create-requested;
    callback schedule-toggled(int);
    callback extension-toggled(int);
    callback deliverable-selected(int);
    callback deliverable-pin-toggle-requested;

    min-width: 0px;
    preferred-width: 0px;
    max-width: 100000px;
    min-height: 0px;
    preferred-height: 0px;
    max-height: 100000px;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    accessible-role: root.palette-open ? AccessibleRole.none : AccessibleRole.region;
    accessible-label: root.palette-open ? "" : "GTA Claw read-only product preview";

    changed palette-open => {
        if (!root.palette-open) {
            root.focus();
            FocusHistory.restore-captured();
        }
    }
    init => {
        root.application-header-geometry-changed(
            root.application-header-title-bounds-fit,
            root.application-header-badge-bounds-fit
        );
        root.viewport-geometry-changed(root.viewport-bounds-fit);
    }
    changed observed-application-header-title-bounds-fit => {
        root.application-header-geometry-changed(
            root.application-header-title-bounds-fit,
            root.application-header-badge-bounds-fit
        );
    }
    changed observed-application-header-badge-bounds-fit => {
        root.application-header-geometry-changed(
            root.application-header-title-bounds-fit,
            root.application-header-badge-bounds-fit
        );
    }
    changed observed-viewport-bounds-fit => {
        root.viewport-geometry-changed(root.viewport-bounds-fit);
    }

    Rectangle { background: DesignTokens.surface-app; }

    product-content := HorizontalLayout {
        visible: !root.palette-open;
        enabled: !root.palette-open;
        spacing: 0px;

        PrimaryNavigation {
            width: root.compact-navigation
                ? max(82px, Metrics.control-large + 2 * Metrics.space-3)
                : max(224px, 112px + Metrics.control-large + 4 * Metrics.space-3);
            horizontal-stretch: 0;
            selected-screen: root.selected-screen;
            compact: root.compact-navigation;
            gateway-status-text: root.gateway-status-text;
            gateway-status-label: root.gateway-status-label;
            gateway-status-icon: root.gateway-status-icon;
            gateway-status-kind: root.gateway-status-kind;
            navigate-requested(index) => { root.navigate-requested(index); }
        }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            application-header := Rectangle {
                height: max(58px, Metrics.control-large + 2 * Metrics.space-2);
                vertical-stretch: 0;
                background: DesignTokens.surface-pane;
                border-width: 1px;
                border-color: DesignTokens.border-default;
                accessible-role: banner;
                accessible-label: "Read-only preview header";

                HorizontalLayout {
                    padding-left: Metrics.space-4;
                    padding-right: Metrics.space-4;
                    spacing: Metrics.space-3;
                    cross-axis-alignment: center;

                    application-title := Text {
                        text: root.selected-screen == 0
                            ? "Focus"
                            : (root.selected-screen == 1
                                ? "Workspaces"
                                : (root.selected-screen == 2
                                    ? "Runs"
                                    : (root.selected-screen == 3
                                        ? "Schedules"
                                        : (root.selected-screen == 4
                                            ? "Deliverables"
                                            : (root.selected-screen == 5
                                                ? "Extensions"
                                                : (root.selected-screen == 6
                                                    ? "Settings"
                                                    : (root.selected-screen == 7
                                                        ? "Session preview"
                                                        : (root.selected-screen == 8 ? "Update" : "Diagnostics"))))))));
                        color: DesignTokens.text-primary;
                        font-size: Metrics.type-title;
                        font-weight: 800;
                        min-width: root.application-title-min-width;
                        horizontal-stretch: 1;
                        overflow: elide;
                        accessible-role: text;
                    }
                    application-badge := SemanticBadge {
                        text: root.compact-navigation ? "P" : "Read-only preview";
                        accessible-name: "Read-only product preview";
                        tone: 2;
                    }
                    preview-dismiss-button := ToolbarIconButton {
                        glyph: "<";
                        accessible-name: "Close read-only preview and return to Gateway diagnostic";
                        focus-id: "product.preview-dismiss";
                        focus-changed(focused) => {
                            root.preview-dismiss-trigger-focus-changed(focused);
                        }
                        clicked => { root.preview-dismiss-requested(); }
                    }
                    palette-button := ToolbarIconButton {
                        glyph: "P";
                        accessible-name: @tr("Open command palette, F1 or Ctrl/Cmd+K");
                        focus-id: "product.palette-trigger";
                        checked: root.palette-open;
                        checkable: true;
                        focus-changed(focused) => { root.palette-trigger-focus-changed(focused); }
                        clicked => {
                            FocusHistory.capture-control(palette-button.focus-id);
                            palette-button.focus();
                            root.palette-toggle-requested();
                        }
                    }
                    if (!root.compact-navigation) : ToolbarIconButton {
                        glyph: "?";
                        accessible-name: "Help and keyboard shortcuts";
                        clicked => {
                            root.settings-section-requested(5);
                            root.navigate-requested(6);
                        }
                    }
                }
            }

            if (root.selected-screen == 0) : FocusScreen {
                runs: root.runs;
                focused-run-index <=> root.focused-run-index;
                awaiting-review: root.dashboard-awaiting-review;
                running: root.dashboard-running;
                blocked: root.dashboard-blocked;
                workspace-count: root.dashboard-workspaces;
                open-session-requested(index) => {
                    root.open-session-requested(index);
                    root.focus();
                }
                focused-run-visibility-changed(visible) => {
                    root.run-focus-visibility-changed(visible);
                }
                background-scroll-position-changed(position) => {
                    root.background-scroll-position-changed(position);
                }
            }
            if (root.selected-screen == 1) : WorkspacesScreen {
                workspaces: root.workspaces;
                open-workspace-requested(index) => {
                    root.open-workspace-requested(index);
                    root.focus();
                }
                card-geometry-changed(
                    index,
                    text-bounds-fit,
                    icon-bounds-fit,
                    badge-bounds-fit,
                    button-bounds-fit,
                    no-overlap,
                    stacked
                ) => {
                    root.workspace-card-geometry-changed(
                        index,
                        text-bounds-fit,
                        icon-bounds-fit,
                        badge-bounds-fit,
                        button-bounds-fit,
                        no-overlap,
                        stacked
                    );
                }
            }
            if (root.selected-screen == 2) : RunsScreen {
                runs: root.runs;
                focused-run-index <=> root.focused-run-index;
                page-label: root.run-page-label;
                can-previous: root.can-previous-run-page;
                can-next: root.can-next-run-page;
                open-session-requested(index) => {
                    root.open-session-requested(index);
                    root.focus();
                }
                previous-requested => { root.previous-run-page-requested(); }
                next-requested => { root.next-run-page-requested(); }
            }
            if (root.selected-screen == 3) : SchedulesScreen {
                schedules: root.schedules;
                interactions-enabled: root.product-interactions-enabled;
                create-requested => { root.schedule-create-requested(); }
                toggled(index) => { root.schedule-toggled(index); }
                card-geometry-changed(
                    index,
                    text-bounds-fit,
                    icon-bounds-fit,
                    badge-bounds-fit,
                    button-bounds-fit,
                    no-overlap,
                    stacked
                ) => {
                    root.schedule-card-geometry-changed(
                        index,
                        text-bounds-fit,
                        icon-bounds-fit,
                        badge-bounds-fit,
                        button-bounds-fit,
                        no-overlap,
                        stacked
                    );
                }
            }
            if (root.selected-screen == 4) : DeliverablesScreen {
                deliverables: root.deliverables;
                selected-index: root.selected-deliverable-index;
                selected-name: root.selected-deliverable-name;
                selected-kind: root.selected-deliverable-kind;
                selected-source: root.selected-deliverable-source;
                selected-size: root.selected-deliverable-size;
                selected-content: root.selected-deliverable-content;
                selected-pinned: root.selected-deliverable-pinned;
                interactions-enabled: root.product-interactions-enabled;
                selected(index) => { root.deliverable-selected(index); }
                pin-toggle-requested => { root.deliverable-pin-toggle-requested(); }
            }
            if (root.selected-screen == 5) : ExtensionsScreen {
                extensions: root.extensions;
                interactions-enabled: root.product-interactions-enabled;
                toggled(index) => { root.extension-toggled(index); }
                card-geometry-changed(
                    index,
                    text-bounds-fit,
                    icon-bounds-fit,
                    badge-bounds-fit,
                    button-bounds-fit,
                    no-overlap,
                    stacked
                ) => {
                    root.extension-card-geometry-changed(
                        index,
                        text-bounds-fit,
                        icon-bounds-fit,
                        badge-bounds-fit,
                        button-bounds-fit,
                        no-overlap,
                        stacked
                    );
                }
            }
            if (root.selected-screen == 6) : SettingsScreen {
                selected-section: root.selected-settings-section;
                compact-navigation: root.compact-navigation;
                gateway-status-text: root.gateway-status-text;
                gateway-status-label: root.gateway-status-label;
                gateway-status-icon: root.gateway-status-icon;
                gateway-status-kind: root.gateway-status-kind;
                gateway-server: root.gateway-server;
                gateway-role: root.gateway-role;
                gateway-scopes: root.gateway-scopes;
                gateway-health: root.gateway-health;
                section-requested(index) => { root.settings-section-requested(index); }
                disconnect-requested => { root.disconnect-requested(); }
                update-requested => {
                    root.update-requested();
                    root.focus();
                }
                diagnostics-requested => {
                    root.diagnostics-requested();
                    root.focus();
                }
                appearance-contrast-focus-changed(focused) => {
                    root.appearance-contrast-focus-changed(focused);
                }
                rail-geometry-changed(bounds-fit) => {
                    root.settings-rail-geometry-changed(bounds-fit);
                }
            }
            if (root.selected-screen == 7) : SessionScreen {
                transcript: root.transcript;
                activity: root.activity;
                diff-lines: root.diff-lines;
                files: root.session-files;
                selected-file-index: root.selected-file-index;
                selected-file-name: root.selected-file-name;
                diff-mode: root.diff-mode;
                narrow: root.session-narrow-layout;
                session-title: root.session-title;
                session-state: root.session-state;
                session-detail: root.session-detail;
                session-tone: root.session-tone;
                can-approve: root.can-approve;
                can-answer: root.can-answer;
                interactions-enabled: root.product-interactions-enabled;
                approval-prompt: root.approval-prompt;
                approval-scope: root.approval-scope;
                question: root.question;
                back-requested => {
                    root.back-requested();
                    root.focus();
                }
                diff-mode-requested(mode) => { root.diff-mode-requested(mode); }
                approval-requested(approved) => { root.approval-requested(approved); }
                approval-geometry-changed(
                    text-bounds-fit,
                    controls-bounds-fit,
                    controls-no-overlap,
                    stacked
                ) => {
                    root.approval-geometry-changed(
                        text-bounds-fit,
                        controls-bounds-fit,
                        controls-no-overlap,
                        stacked
                    );
                }
                question-geometry-changed(
                    text-bounds-fit,
                    controls-bounds-fit,
                    controls-no-overlap,
                    stacked
                ) => {
                    root.question-geometry-changed(
                        text-bounds-fit,
                        controls-bounds-fit,
                        controls-no-overlap,
                        stacked
                    );
                }
                header-geometry-changed(
                    text-bounds-fit,
                    back-bounds-fit,
                    status-bounds-fit,
                    no-overlap,
                    stacked
                ) => {
                    root.session-header-geometry-changed(
                        text-bounds-fit,
                        back-bounds-fit,
                        status-bounds-fit,
                        no-overlap,
                        stacked
                    );
                }
                answer-requested(answer) => { root.answer-requested(answer); }
                message-submitted(message) => { root.message-submitted(message); }
                file-selected(index) => { root.file-selected(index); }
            }
            if (root.selected-screen == 8) : UpdateScreen {
                back-requested => {
                    root.back-requested();
                    root.focus();
                }
            }
            if (root.selected-screen == 9) : DiagnosticsScreen {
                gateway-status-text: root.gateway-status-text;
                gateway-status-label: root.gateway-status-label;
                gateway-status-icon: root.gateway-status-icon;
                gateway-status-kind: root.gateway-status-kind;
                gateway-server: root.gateway-server;
                gateway-health: root.gateway-health;
                back-requested => {
                    root.back-requested();
                    root.focus();
                }
            }
        }
    }

    if (root.palette-open) : CommandPalette {
        width: 100%;
        height: 100%;
        query <=> root.palette-query;
        commands: root.palette-commands;
        selected-index: root.palette-selected-index;
        command-count: root.palette-command-count;
        selected-action-id: root.palette-selected-action-id;
        selected-label: root.palette-selected-label;
        focused-command-index <=> root.palette-focused-command-index;
        dismiss-requested => { root.palette-dismiss-requested(); }
        query-changed(query) => { root.palette-query-changed(query); }
        selection-step-requested(step) => { root.palette-selection-step-requested(step); }
        selection-index-requested(index) => { root.palette-selection-index-requested(index); }
        command-requested(action-id) => { root.palette-command-requested(action-id); }
    }
}
