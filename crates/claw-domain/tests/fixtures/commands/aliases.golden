# Golden alias table for the pinned command registry.
#
# Source: openclaw/openclaw@b43e832fcc8000ed7287c7accc54e381db607f85
#   src/auto-reply/commands-registry.shared.ts (defineChatCommand + registerAlias)
#   docs/tools/slash-commands.md (feature and owner gates)
#
# Extracted mechanically from the pinned TypeScript, then reviewed by hand.
# `alias` repeats once per registered text alias, in registration order.

key: help
scope: both
native_name: help
alias: /help
accepts_args: false
owner_required: false

