{
    "purpose":  "Reachability differential corpus: constructs that occur in NEITHER real tree, so a whole-tree sweep cannot compare the two implementations on them.",
    "rule":  "a cargo test target root, or a source file reachable from one",
    "cases":  [
                  {
                      "name":  "inline-path-mod-rs-accept",
                      "files":  {
                                    "Cargo.toml":  "[workspace]\nmembers = [\"crates/p\"]\nresolver = \"2\"\n",
                                    "crates/p/Cargo.toml":  "[package]\nname = \"p\"\nversion = \"0.1.0\"\nedition = \"2021\"\n",
                                    "crates/p/src/lib.rs":  "#[path = \"actual\"]\nmod outer {\n    #[path = \"proof.rs\"]\n    mod proof;\n}\n",
                                    "crates/p/src/actual/proof.rs":  "#[test]\nfn evidence_test() {\n    assert!(true);\n}\n",
                                    "crates/p/src/outer/proof.rs":  "compile_error!(\"decoy - cargo never compiles this\");\n"
                                },
                      "cite":  "crates/p/src/actual/proof.rs",
                      "expect":  "accept",
                      "why":  "#[path] on an inline mod renames the child directory; cargo compiles actual/proof.rs"
                  },
