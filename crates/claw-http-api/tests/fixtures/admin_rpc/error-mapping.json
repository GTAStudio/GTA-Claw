{
  "description": "Every Admin HTTP RPC failure class and the status, envelope and stable code it maps to. A class is listed exactly once; the test asserts this table is complete against the AdminRpcError enum, so a new class cannot be added without a reviewed row here.",
  "envelopes": {
    "transport": "{\"ok\":false,\"error\":{\"type\":..,\"message\":..}}",
    "rpc": "{\"id\":..,\"ok\":false,\"error\":{\"code\":..,\"message\":..}}"
  },
  "classes": [
