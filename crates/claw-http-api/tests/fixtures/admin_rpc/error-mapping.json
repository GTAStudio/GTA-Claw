      "envelope": "transport",
      "code": "unavailable"
    },
    {
      "class": "method_not_allowlisted",
      "status": 400,
      "envelope": "rpc",
      "code": "INVALID_REQUEST"
    },
    {
      "class": "method_not_registered",
      "status": 400,
      "envelope": "transport",
      "code": "invalid_request"
    },
    {
      "class": "method_not_operator_surface",
      "status": 403,
      "envelope": "transport",
      "code": "forbidden"
    },
    {
      "class": "malformed_request",
      "status": 400,
      "envelope": "transport",
      "code": "invalid_request"
    },
    {
      "class": "body_too_large",
