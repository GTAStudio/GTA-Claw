      "envelope": "transport",
      "code": "invalid_request"
    },
    {
      "class": "body_timeout",
      "status": 408,
      "envelope": "transport",
      "code": "invalid_request"
    },
    {
      "class": "dispatch_timeout",
      "status": 504,
      "envelope": "rpc",
      "code": "AGENT_TIMEOUT"
    },
    {
      "class": "dispatch",
      "status": 500,
      "envelope": "rpc",
      "code": "GATEWAY_CODE"
    }
