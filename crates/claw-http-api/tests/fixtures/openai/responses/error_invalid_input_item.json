{
  "description": "An input array whose items are not objects is a request error, distinct from a missing input.",
  "feature_id": "interop.openai.openresponses",
  "request": {
    "body": {
      "input": [
        "hello"
      ],
      "model": "openclaw"
    },
    "method": "POST",
    "path": "/v1/responses",
    "token": "operator-token"
  },
  "response": {
    "body": {
      "error": {
        "message": "invalid request",
        "type": "invalid_request_error"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "status": 400
  }
}
