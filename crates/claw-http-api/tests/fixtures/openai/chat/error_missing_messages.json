{
  "description": "A body with no addressable user message is a request error rather than an empty generation.",
  "feature_id": "interop.openai.chat-completions",
  "request": {
    "body": {
      "messages": [
        {
          "content": "",
          "role": "assistant"
        }
      ],
      "model": "openclaw"
    },
    "method": "POST",
    "path": "/v1/chat/completions",
    "token": "operator-token"
  },
  "response": {
    "body": {
      "error": {
        "message": "Missing user message in `messages`.",
        "type": "invalid_request_error"
      }
    },
    "headers": {
      "content-type": "application/json"
    },
    "status": 400
  }
}
