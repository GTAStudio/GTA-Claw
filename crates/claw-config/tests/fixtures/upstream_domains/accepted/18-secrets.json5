// Accepted fixture for pinned top-level domain `secrets`
// (compat/upstream/inventories/config-domains.json).
{
  secrets: {
    providers: {
      environment: { source: "env", allowlist: ["CLAW_*"] },
      onDisk: { source: "file", path: "/run/secrets/claw" },
    },
    defaults: {
      env: "CLAW_",
      file: "/run/secrets",
      exec: "/usr/local/bin/claw-secret",
    },
    resolution: {
      maxProviderConcurrency: 4,
      maxRefsPerProvider: 32,
      maxBatchBytes: 65536,
    },
  },
}
