{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta.studio/schemas/legacy/behavior-inventory.schema.json",
  "type": "object",
  "required": ["source_revision", "behaviors"],
  "properties": {
    "$schema": { "type": "string" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "behavior_id",
          "feature_id",
          "classification",
          "summary",
          "source"
        ],
        "properties": {
          "behavior_id": { "type": "string", "pattern": "^behavior\\.[a-z0-9_.-]+$" },
          "feature_id": { "type": "string", "pattern": "^legacy\\.[a-z0-9_.-]+$" },
          "classification": {
            "enum": ["preserved", "compatibility_shim", "manual_port", "deliberate_break"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "source": {
            "type": "object",
            "required": ["path", "line_start", "line_end"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "line_start": { "type": "integer", "minimum": 1 },
              "line_end": { "type": "integer", "minimum": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
