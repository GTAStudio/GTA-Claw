{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta.studio/schemas/legacy/migration-result.schema.json",
  "type": "object",
  "required": [
    "contract_version",
    "input",
    "status",
    "exit_code",
    "recognized_bridges",
    "remaining_javascript",
    "artifacts",
    "diagnostics"
  ],
  "properties": {
    "contract_version": { "const": "1.0.0" },
    "input": {
      "type": "object",
      "required": ["kind", "source", "sha256"],
      "properties": {
        "kind": { "enum": ["role", "legacy_skill", "environment"] },
        "source": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "status": { "enum": ["migrated", "manual_port_required", "invalid_input", "failed"] },
    "exit_code": { "type": "integer", "minimum": 0 },
    "recognized_bridges": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["httpGet", "httpPost", "log"] }
    },
    "remaining_javascript": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["location", "reason"],
        "properties": {
          "location": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "path", "sha256", "signature"],
        "properties": {
          "kind": { "enum": ["wasi_manifest", "wit_scaffold", "role", "json5_config"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "signature": {
            "type": "object",
            "required": ["algorithm", "key_id", "value"],
            "properties": {
              "algorithm": { "enum": ["ed25519"] },
              "key_id": { "type": "string", "minLength": 1 },
              "value": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["info", "warning", "error"] },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "migrated" } } },
      "then": {
        "properties": {
          "exit_code": { "const": 0 },
          "remaining_javascript": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "manual_port_required" } } },
      "then": {
        "properties": {
          "exit_code": { "const": 2 },
          "remaining_javascript": { "minItems": 1 },
          "artifacts": {
            "minItems": 2,
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": { "kind": { "const": "wasi_manifest" } }
                },
                "minContains": 1
              },
              {
                "contains": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": { "kind": { "const": "wit_scaffold" } }
                },
                "minContains": 1
              }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "invalid_input" } } },
      "then": { "properties": { "exit_code": { "const": 3 } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } } },
      "then": { "properties": { "exit_code": { "const": 1 } } }
    },
    {
      "if": {
        "required": ["remaining_javascript"],
        "properties": { "remaining_javascript": { "minItems": 1 } }
      },
      "then": { "properties": { "exit_code": { "not": { "const": 0 } } } }
    }
  ],
  "additionalProperties": false
}
