{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta.studio/schemas/legacy/role.schema.json",
  "type": "object",
  "properties": {
    "content": {},
    "prompt": {},
    "model": { "type": "string" }
  },
  "oneOf": [
    {
      "required": ["content"],
      "properties": {
        "content": { "type": "string", "minLength": 1 }
      }
    },
    {
      "required": ["prompt"],
      "properties": {
        "prompt": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        { "not": { "required": ["content"] } },
        {
          "required": ["content"],
          "properties": {
            "content": { "not": { "type": "string" } }
          }
        }
      ]
    }
  ],
  "additionalProperties": true
}
