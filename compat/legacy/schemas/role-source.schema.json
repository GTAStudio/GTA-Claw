{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta.studio/schemas/legacy/role-source.schema.json",
  "type": "object",
  "required": ["content_type", "body", "expected"],
  "properties": {
    "content_type": { "type": "string" },
    "body": {
      "oneOf": [
        { "type": "string" },
        { "$ref": "role.schema.json" }
      ]
    },
    "expected": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["loaded_json", "loaded_plain_text", "error"] },
        "content": { "type": "string" },
        "model": { "type": "string" },
        "error_contains": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
