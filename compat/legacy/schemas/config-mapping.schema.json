{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta.studio/schemas/legacy/config-mapping.schema.json",
  "type": "object",
  "required": ["source_revision", "proposed_format", "mappings"],
  "properties": {
    "$schema": { "type": "string" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "proposed_format": { "const": "JSON5" },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "legacy_env",
          "scope",
          "target_json5_key",
          "secret",
          "default",
          "conversion",
          "validation",
          "required_when"
        ],
        "properties": {
          "legacy_env": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
          "aliases": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" }
          },
          "scope": { "enum": ["runtime", "deployer", "build", "ci"] },
          "target_json5_key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
          "secret": { "type": "boolean" },
          "default": {},
          "conversion": { "type": "string", "minLength": 1 },
          "validation": { "type": "string", "minLength": 1 },
          "required_when": { "type": "string" },
          "known_legacy_quirk": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
