{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gta.studio/schemas/legacy/feature-ledger.schema.json",
  "type": "object",
  "required": ["source_revision", "features"],
  "properties": {
    "$schema": { "type": "string" },
    "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "domain",
          "source",
          "status",
          "acceptance_fixture",
          "migration_decision",
          "known_differences"
        ],
        "properties": {
          "feature_id": { "type": "string", "pattern": "^legacy\\.[a-z0-9_.-]+$" },
          "domain": { "type": "string", "minLength": 1 },
          "source": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["path", "line_start", "line_end"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "line_start": { "type": "integer", "minimum": 1 },
                "line_end": { "type": "integer", "minimum": 1 }
              },
              "additionalProperties": false
            }
          },
          "status": { "enum": ["current_supported", "current_conditional", "current_degraded"] },
          "acceptance_fixture": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "migration_decision": {
            "enum": ["preserve", "rust_compat_shim", "manual_rust_wasi_port", "remove"]
          },
          "known_differences": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
