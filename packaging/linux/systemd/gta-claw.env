# Exact non-secret phase-1 process environment.
ENABLE_TEAMS=false

# Required before explicitly enabling the service:
# AGENT_ROLE_URL=<required-absolute-http-or-https-role-url>
#
# The environment-supported GitHub mode is device flow:
# DEVICE_FLOW_ENABLED=true
# GITHUB_CLIENT_ID=<required-nonsecret-device-flow-client-id>
#
# Never place a token, password, client secret, private key, proxy credential,
# or other secret here. Typed secrets belong in
# /etc/gta-claw/credentials/daemon.conf and are exposed only through
# $CREDENTIALS_DIRECTORY/gta-claw-config.
