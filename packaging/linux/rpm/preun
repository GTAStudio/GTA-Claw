# shellcheck shell=sh disable=SC2317
set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

replacement=/run/gta-claw-daemon.replacement
ready=/run/gta-claw-daemon.ready-for-replacement
was_active=/run/gta-claw-daemon.was-active
remove_was_active=/run/gta-claw-daemon.remove-was-active
remove_was_enabled=/run/gta-claw-daemon.remove-was-enabled
remove_was_enabled_runtime=/run/gta-claw-daemon.remove-was-enabled-runtime
runtime_directory=/run/gta-claw-state-init
failure_marker=$runtime_directory/initialization-failed
replacement_fence=$runtime_directory/replacement-fenced
remove_initializer_was_active=$runtime_directory/remove-was-active
lock=/var/lib/gta-claw-protected/state.writer.lock
prepared=0
package_fenced=0

lock_holder_pid() {
  if ! locks="$(lslocks --noheadings --notruncate --output PID,PATH)"; then
    return 1
  fi
  printf '%s\n' "$locks" |
    awk -v path="$lock" '$2 == path { print $1; exit }'
}

verify_unit_stopped() {
  unit="$1"
  active_state="$(systemctl show -P ActiveState "$unit")"
  main_pid="$(systemctl show -P MainPID "$unit")"
  control_pid="$(systemctl show -P ControlPID "$unit")"
  case "$active_state:$main_pid:$control_pid" in
    inactive:0:0 | failed:0:0) ;;
    *) return 1 ;;
  esac
}

verify_writer_lock_released() {
  lock_pid="$(lock_holder_pid)" || return 1
  [ -z "$lock_pid" ]
}

stop_initializer() {
  initializer_load_state="$(systemctl show -P LoadState gta-claw-state-init.service)"
  case "$initializer_load_state" in
    loaded | masked)
      systemctl stop gta-claw-state-init.service
      verify_unit_stopped gta-claw-state-init.service
      ;;
    not-found) ;;
    *) return 1 ;;
  esac
}

ensure_failure_fence() {
  if [ -L "$runtime_directory" ] ||
    { [ -e "$runtime_directory" ] && [ ! -d "$runtime_directory" ]; }; then
    return 1
  fi
  if [ ! -e "$runtime_directory" ]; then
    mkdir -m 0755 -- "$runtime_directory"
  fi
  if [ "$(stat -c '%u:%g:%a' "$runtime_directory")" != "0:0:755" ]; then
    return 1
  fi
  touch "$failure_marker"
}

fence_failed_restore() {
  if ! ensure_failure_fence; then
    echo "gta-claw removal rollback could not retain its failure fence" >&2
  fi
  if ! systemctl mask --runtime gta-claw-daemon.service >/dev/null 2>&1; then
    echo "gta-claw daemon could not be runtime-masked after RPM removal rollback failure" >&2
  fi
  if ! systemctl stop gta-claw-daemon.service >/dev/null 2>&1; then
    echo "gta-claw daemon stop failed after RPM removal rollback failure" >&2
  fi
  if ! systemctl stop gta-claw-state-init.service >/dev/null 2>&1; then
    echo "gta-claw initializer stop failed after RPM removal rollback failure" >&2
  fi
  verify_unit_stopped gta-claw-daemon.service
  verify_writer_lock_released
  exit 1
}

restore_enablement() {
  if [ -e "$remove_was_enabled" ]; then
    systemctl enable gta-claw-daemon.service >/dev/null
  elif [ -e "$remove_was_enabled_runtime" ]; then
    systemctl enable --runtime gta-claw-daemon.service >/dev/null
  fi
}

restore_on_failure() {
  status=$?
  trap - 0 HUP INT TERM
  if [ "$prepared" -eq 0 ]; then
    if [ "$package_fenced" -eq 1 ]; then
      restore_enablement >/dev/null 2>&1 || fence_failed_restore
      ensure_failure_fence || fence_failed_restore
      systemctl mask --runtime gta-claw-daemon.service >/dev/null 2>&1 ||
        fence_failed_restore
      systemctl stop gta-claw-daemon.service >/dev/null 2>&1 ||
        fence_failed_restore
      verify_unit_stopped gta-claw-daemon.service
      verify_writer_lock_released
    else
      systemctl unmask --runtime gta-claw-daemon.service >/dev/null 2>&1 ||
        fence_failed_restore
      systemctl daemon-reload >/dev/null 2>&1 || fence_failed_restore
      if [ "$(systemctl show -P ActiveState gta-claw-daemon.service)" = "failed" ]; then
        systemctl reset-failed gta-claw-daemon.service >/dev/null 2>&1 ||
          fence_failed_restore
      fi
      restore_enablement >/dev/null 2>&1 || fence_failed_restore
      if [ -e "$remove_initializer_was_active" ]; then
        systemctl start gta-claw-state-init.service >/dev/null 2>&1 ||
          fence_failed_restore
      fi
      if [ -e "$remove_was_active" ]; then
        systemctl start gta-claw-daemon.service >/dev/null 2>&1 ||
          fence_failed_restore
        /usr/libexec/gta-claw/gta-claw-runtime-ready >/dev/null 2>&1 ||
          fence_failed_restore
      fi
    fi
  fi
  exit "$status"
}

if [ -d /run/systemd/system ]; then
  if [ "$1" -eq 0 ]; then
    rm -f \
      "$remove_was_active" \
      "$remove_was_enabled" \
      "$remove_was_enabled_runtime" \
      "$remove_initializer_was_active"
    if ! enabled_state="$(systemctl is-enabled gta-claw-daemon.service 2>/dev/null)"; then
      : # disabled and not-found states are returned with nonzero status.
    fi
    case "$enabled_state" in
      masked | masked-runtime)
        if [ ! -e "$replacement_fence" ] || [ ! -e "$failure_marker" ]; then
          echo "refusing externally masked gta-claw daemon during RPM removal" >&2
          exit 1
        fi
        package_fenced=1
        trap restore_on_failure 0 HUP INT TERM
        verify_unit_stopped gta-claw-daemon.service
        verify_writer_lock_released
        systemctl unmask --runtime gta-claw-daemon.service
        systemctl daemon-reload
        if ! enabled_state="$(systemctl is-enabled gta-claw-daemon.service 2>/dev/null)"; then
          : # disabled and not-found states are returned with nonzero status.
        fi
        ;;
    esac
    case "$enabled_state" in
      enabled) touch "$remove_was_enabled" ;;
      enabled-runtime) touch "$remove_was_enabled_runtime" ;;
      disabled | indirect | static | generated | transient | not-found | '') ;;
      *) {
        echo "unexpected gta-claw enablement state before RPM removal: $enabled_state" >&2
        exit 1
      } ;;
    esac
    active_state="$(systemctl show -P ActiveState gta-claw-daemon.service)"
    case "$active_state" in
      inactive | failed) ;;
      active | activating | reloading | deactivating)
        touch "$remove_was_active"
        ;;
      *) {
        echo "unexpected gta-claw active state before RPM removal: $active_state" >&2
        exit 1
      } ;;
    esac
    initializer_active_state="$(systemctl show -P ActiveState gta-claw-state-init.service)"
    case "$initializer_active_state" in
      active | activating | reloading | deactivating)
        touch "$remove_initializer_was_active"
        ;;
      inactive | failed) ;;
      *) {
        echo "unexpected gta-claw initializer state before RPM removal: $initializer_active_state" >&2
        exit 1
      } ;;
    esac
    trap restore_on_failure 0 HUP INT TERM
    systemctl mask --runtime gta-claw-daemon.service
    systemctl stop gta-claw-daemon.service
    verify_unit_stopped gta-claw-daemon.service
    if [ -e "$remove_was_enabled" ]; then
      systemctl disable gta-claw-daemon.service
    elif [ -e "$remove_was_enabled_runtime" ]; then
      systemctl disable --runtime gta-claw-daemon.service
    fi
    stop_initializer
    verify_writer_lock_released
    prepared=1
    trap - 0 HUP INT TERM
  elif [ -e "$replacement" ] && [ -e "$was_active" ]; then
    test -e "$ready"
    systemctl is-active --quiet gta-claw-daemon.service
    main_pid="$(systemctl show -P MainPID gta-claw-daemon.service)"
    case "$main_pid" in
      '' | 0 | *[!0-9]*) exit 1 ;;
    esac
    test "$(lock_holder_pid)" = "$main_pid"
  fi
fi

exit 0
