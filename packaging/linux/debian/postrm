#!/bin/sh

set -e

if [ "$1" = "remove" ] && [ -z "${DPKG_ROOT:-}" ] &&
  [ -d /run/systemd/system ]; then
  systemctl --system daemon-reload >/dev/null || true
fi

if [ "$1" = "purge" ] && [ -x /usr/bin/deb-systemd-helper ]; then
  deb-systemd-helper purge gta-claw-daemon.service >/dev/null || true
fi

exit 0
