#!/bin/sh

set -eu

PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

lock=/var/lib/gta-claw-protected/state.writer.lock
ready_marker=/run/gta-claw-daemon.ready-for-replacement
failure_marker=/run/gta-claw-state-init/initialization-failed
runtime_directory=/run/gta-claw-state-init

ensure_failure_fence() {
  if [ -L "$runtime_directory" ] ||
    { [ -e "$runtime_directory" ] && [ ! -d "$runtime_directory" ]; }; then
    return 1
  fi
  if [ ! -e "$runtime_directory" ]; then
    mkdir -m 0755 -- "$runtime_directory"
  fi
  if [ "$(stat -c '%u:%g:%a' "$runtime_directory")" != "0:0:755" ]; then
    return 1
  fi
  if [ -L "$failure_marker" ] ||
    { [ -e "$failure_marker" ] && [ ! -f "$failure_marker" ]; }; then
    return 1
  fi
  touch "$failure_marker"
  chown 0:0 "$failure_marker"
  chmod 0644 "$failure_marker"
}

lock_holder_pid() {
  if ! locks="$(lslocks --noheadings --notruncate --output PID,PATH)"; then
    return 2
  fi
  printf '%s\n' "$locks" |
    awk -v path="$lock" '$2 == path { print $1; exit }'
}

fail_readiness() {
  reason="$1"
  if ! ensure_failure_fence; then
    echo "gta-claw initialization failure fence could not be retained" >&2
  fi
  if ! rm -f "$ready_marker"; then
    echo "gta-claw readiness marker could not be removed" >&2
  fi
  echo "$reason" >&2
  if ! systemctl mask --runtime gta-claw-daemon.service >/dev/null 2>&1; then
    echo "gta-claw daemon could not be runtime-masked after readiness failure" >&2
  fi
  if ! systemctl stop gta-claw-daemon.service >/dev/null 2>&1; then
    echo "gta-claw daemon stop failed after readiness failure" >&2
  fi
  if ! active_state="$(systemctl show -P ActiveState gta-claw-daemon.service 2>/dev/null)"; then
    active_state=unknown
  fi
  if ! main_pid="$(systemctl show -P MainPID gta-claw-daemon.service 2>/dev/null)"; then
    main_pid=unknown
  fi
  if ! control_pid="$(systemctl show -P ControlPID gta-claw-daemon.service 2>/dev/null)"; then
    control_pid=unknown
  fi
  case "$active_state:$main_pid:$control_pid" in
    inactive:0:0 | failed:0:0) ;;
    *) echo "gta-claw daemon remains $active_state with MainPID $main_pid and ControlPID $control_pid after readiness failure" >&2 ;;
  esac
  if lock_pid="$(lock_holder_pid)"; then
    if [ -n "$lock_pid" ]; then
      echo "gta-claw writer lock remains held by PID $lock_pid after readiness failure" >&2
    fi
  else
    echo "gta-claw writer-lock release could not be inspected after readiness failure" >&2
  fi
  exit 1
}

if [ -e "$failure_marker" ]; then
  fail_readiness "gta-claw initialization failure fence is still present"
fi
if ! rm -f "$ready_marker"; then
  fail_readiness "gta-claw stale readiness marker could not be removed"
fi
attempt=0
while [ "$attempt" -lt 150 ]; do
  if ! systemctl is-active --quiet gta-claw-daemon.service; then
    fail_readiness "gta-claw daemon became inactive before readiness"
  fi
  if ! main_pid="$(systemctl show -P MainPID gta-claw-daemon.service)"; then
    fail_readiness "gta-claw daemon MainPID could not be inspected"
  fi
  case "$main_pid" in
    '' | 0 | *[!0-9]*)
      fail_readiness "gta-claw daemon has no valid MainPID"
      ;;
  esac
  if ! lock_pid="$(lock_holder_pid)"; then
    fail_readiness "gta-claw writer-lock ownership could not be inspected"
  fi
  if [ "$lock_pid" = "$main_pid" ]; then
    if ! touch "$ready_marker"; then
      fail_readiness "gta-claw readiness marker could not be created"
    fi
    exit 0
  fi
  if [ -n "$lock_pid" ]; then
    fail_readiness "gta-claw writer lock is held by a different process"
  fi
  attempt=$((attempt + 1))
  sleep 0.1
done

fail_readiness "gta-claw daemon did not own the writer lock before the readiness deadline"
