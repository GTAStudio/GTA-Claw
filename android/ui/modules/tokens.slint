// Shared visual constants for the GTA Claw Android shell.

export global Tokens {
    out property <length> page-padding: 16px;
    out property <length> gap: 12px;
    out property <length> tight-gap: 4px;
    out property <length> radius: 12px;
    out property <length> pill-radius: 999px;
    out property <length> label-size: 13px;
    out property <length> value-size: 15px;
    out property <length> title-size: 22px;

    out property <color> neutral: #5f6368;
    out property <color> info: #1a73e8;
    out property <color> success: #1e8e3e;
    out property <color> warning: #b06000;
    out property <color> danger: #c5221f;
}
