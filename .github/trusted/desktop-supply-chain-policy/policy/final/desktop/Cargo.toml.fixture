[workspace]
members = ["apps/gta-claw-desktop"]
resolver = "3"

[workspace.package]
version = "0.1.0"
edition = "2024"
rust-version = "1.94.0"
license = "MIT"
repository = "https://github.com/GTAStudio/GTA-Claw"

[workspace.dependencies]
claw-application = { path = "../crates/claw-application", version = "0.1.0" }
claw-gateway-client = { path = "../crates/claw-gateway-client", version = "0.1.0" }
claw-platform = { path = "../crates/claw-platform", version = "0.1.0" }
claw-protocol = { path = "../crates/claw-protocol", version = "0.1.0" }
claw-security = { path = "../crates/claw-security", version = "0.1.0" }

[workspace.lints.rust]
missing_docs = "warn"
# Slint's generated item-tree macros locally allow their audited unsafe internals.
unsafe_code = "deny"
unsafe_op_in_unsafe_fn = "deny"
unreachable_pub = "warn"

[workspace.lints.rustdoc]
broken_intra_doc_links = "deny"
invalid_html_tags = "warn"
private_intra_doc_links = "warn"
unescaped_backticks = "warn"

[workspace.lints.clippy]
all = { level = "warn", priority = -1 }
pedantic = { level = "warn", priority = -1 }
nursery = { level = "warn", priority = -1 }
# `unreachable_pub` (enabled above) and `redundant_pub_crate` are mutually
# contradictory: satisfying either one re-triggers the other.
redundant_pub_crate = "allow"
# UI wiring surfaces are long by construction: one screen's property fan-out is a
# single unit of meaning and splitting it hides the binding it documents.
too_many_lines = "allow"

[profile.release]
codegen-units = 1
lto = "thin"
strip = "symbols"
panic = "unwind"

[profile.dev]
debug = "line-tables-only"

[profile.dev.package."*"]
opt-level = 2
debug = false

[profile.test]
debug = "line-tables-only"

[profile.test.package."*"]
opt-level = 2
debug = false
