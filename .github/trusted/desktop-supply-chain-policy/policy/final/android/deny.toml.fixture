[graph]
all-features = true
targets = [
  { triple = "aarch64-linux-android" },
  { triple = "x86_64-linux-android" },
]

[advisories]
ignore = [
  # Slint 1.17.1's image pipeline still reaches these unmaintained crates.
  # They are not vulnerabilities, and there is no compatible replacement in
  # the pinned Slint graph.
  "RUSTSEC-2024-0436",
  "RUSTSEC-2026-0192",
  "RUSTSEC-2026-0206",
]

[licenses]
allow = [
  "Apache-2.0",
  "BSD-2-Clause",
  "BSD-3-Clause",
  "BSL-1.0",
  "ISC",
  "LicenseRef-Slint-Royalty-free-2.0",
  "MIT",
  "NCSA",
  "Unicode-3.0",
  "Zlib",
]
confidence-threshold = 0.8
unused-allowed-license = "allow"

[bans]
multiple-versions = "deny"
wildcards = "deny"
highlight = "all"
skip = [
  # Slint's compiler/font stack still spans these older exact releases.
  { name = "font-types", version = "=0.11.3" },
  { name = "hashbrown", version = "=0.14.5" },
  { name = "hashbrown", version = "=0.16.1" },
  { name = "itertools", version = "=0.13.0" },
  { name = "nom", version = "=7.1.3" },
  { name = "read-fonts", version = "=0.39.2" },
  { name = "rustc-hash", version = "=1.1.0" },
  { name = "skrifa", version = "=0.42.1" },
  # The Android activity backend and current ndk-context line straddle jni-sys.
  { name = "jni-sys", version = "=0.3.1" },
  # fastwebsockets remains on rand_core 0.6 while claw-security uses 0.10.
  { name = "rand_core", version = "=0.6.4" },
  # Native build dependencies have not converged on one shlex release.
  { name = "shlex", version = "=1.3.0" },
  # Proc-macro dependencies have not converged on one syn release.
  { name = "syn", version = "=2.0.119" },
  # Slint's older runtime dependencies remain on thiserror 1 while newer
  # dependencies use thiserror 2.
  { name = "thiserror", version = "=1.0.69" },
  { name = "thiserror-impl", version = "=1.0.69" },
]
skip-tree = []

[sources]
unknown-registry = "deny"
unknown-git = "deny"
allow-registry = ["https://github.com/rust-lang/crates.io-index"]
allow-git = []
